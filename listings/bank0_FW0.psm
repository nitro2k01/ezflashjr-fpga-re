;==============================================================================
; EZ-Flash Junior FPGA (XC3S200A) - PicoBlaze KCPSM3, program BANK 0
; Firmware FW0 (golden and application images share this bank 0).
;
; Commented disassembly. Re-assembles to the original 1024 words (pbasm.py).
; Labels, comments and section headers are shared with the FW4 listing and
; were carried over by instruction alignment; code that only exists in this
; version is annotated separately.
;------------------------------------------------------------------------------
; ARCHITECTURE
;   One KCPSM3 core runs from two 1K-word program BRAMs (bank 0 = this file,
;   bank 1 = the updater/licence code). Output port C8 selects the bank; the
;   switch happens inside the routine at 3F0, which exists at the same address
;   in both banks (see bank_call). Registers and the 64-byte scratchpad are
;   shared, which is how bank 1 hands results back (scratchpad 3E/3F).
;
;   The core resets into bank 0. Bank 1 is entered twice:
;     - at boot (3F = 0): licence check against the Device DNA; on success
;       bank 1 leaves 3E=F1, 3F=F2, which unlocks ROM loading here.
;     - on event 08 (3F = 1): program one 256-byte page of the SPI config flash
;       (firmware update).
;
; FUNCTIONS IN THIS BANK
;   - SD card bring-up and sector transfers through an SD host controller with
;     DMA, reached over a Wishbone-style bridge (ports 70-73 + indexed port).
;     Register layout and command-word format are consistent with the
;     OpenCores sd_card_controller (Marek Czerski).
;   - ROM loading from the SD card (cluster by cluster, from the 512-byte
;     load table written by the Game Boy at $7F36=1).
;   - PCF8563 real-time clock over bit-banged I2C: init, continuous readout
;     into the Game Boy RTC window, and setting the time.
;
; SD CONTROLLER REGISTERS (Wishbone address = port number used with (sE))
;   00 argument          04 command (index<<8 | flags)   08-14 response
;   18 data timeout?     1C bus width (1 = 4-bit)        20 cmd timeout?
;   24 clock divider     28 software reset               34 cmd event status
;   38 cmd event enable  3C data event status            40 data event enable
;   44 block size - 1    48 block count - 1              60 DMA address
;   Command flags (low byte): b1:0 response (01 = 48-bit, 10 = 136-bit),
;   b2 busy check, b3 CRC check, b4 index check, b5 read data, b6 write data.
;   Routine sd_cmd takes "sB" flags: b0 response, b1 long, b2 CRC check,
;   b3 busy, b4 index check (15 = R1, 1D = R1b, 07 = R2, 01 = R3).
;
; INPUT PORTS                               OUTPUT PORTS
;   00-7F (sE) Wishbone ack, b1:0 != 0        00-7F (sE) Wishbone write strobe
;   70-73  Wishbone read data (70 = LSB)      70-73  Wishbone write data (70 = LSB)
;   A0     debug TX status, b2 = busy         A1     debug byte out
;   B0-B3  sector number ($7FB0-$7FB3)        BF     load-table word index
;   B4     sector count ($7FB4)               C8     program bank select (1 = bank 1)
;   B5     event flags (see isr)              E0-E3  ROM-load destination (file sector)
;   B6     RTC byte written by the GB         EC     I2C out: b0 SCL, b1 SDA (1 = release)
;   B9     01 while the RTC window is mapped  ED/EE  RTC window index / data
;   C0-C3  load-table word (C0 = b31:24)      EF     ROM load busy (1 = loading)
;   EB     I2C in: b0 SCL, b1 SDA             F0     index of RTC byte to fetch on B6
;   (A2, A3, B7, E4-E7, E9, F2 are only used by unreachable code)
;
; SCRATCHPAD
;   00 ACMD41 retry counter        01 02 = SD v2 card (CMD8 echo ok)
;   02-05 last response (02 = b31:24 .. 05 = b7:0)
;   06 01 = high-capacity card (block addressing)
;   13-16 CID response (first word)    17-18 RCA
;   19 data phase of next command: 01 read, 02 write
;   1A-1D DMA address (1A = MSB)       1E-1F block size - 1 (01FF)
;   20 block count - 1                 2A/31 sectors per cluster (lo/hi)
;   2C-2F current file sector during ROM load (2F = LSB)
;   3B load-table page (00 = words 00-7F)   3D last data event status
;   3E/3F licence flags (F1/F2 = licensed, written by bank 1)
;   3F also: 01 = "flash page write requested" when entering bank 1
;==============================================================================


            ADDRESS 000

; ------------------------------------------------------------------------------
; RESET: run the bank-1 boot code (licence check), print the licence flags,
; bring up the SD card (CMD0, CMD8, ACMD41, CMD2, CMD3, CMD7, CMD16, ACMD6 4-bit),
; initialise the RTC, then enter the main loop with interrupts enabled.
; ------------------------------------------------------------------------------
reset:
            DISABLE INTERRUPT              ; 000
            LOAD     s2, 00                ; 001  scratch 3F = 0: bank 1 runs its boot path
            STORE    s2, 3F                ; 002
            CALL     bank_call             ; 003  -> bank 1 (licence check, sets 3E/3F)
            FETCH    sF, 3E                ; 004  debug: licence flags (F1, F2 when ok)
            CALL     dbg_putc              ; 005
            FETCH    sF, 3F                ; 006
            CALL     dbg_putc              ; 007
            CALL     clear_scratch         ; 008
            CALL     sdc_init_regs         ; 009  SD controller setup, slow clock
            CALL     delay_m               ; 00A
            CALL     sd_cmd0               ; 00B  CMD0
            LOAD     sF, B0                ; 00C  debug B0
            CALL     dbg_putc              ; 00D
            CALL     delay_s               ; 00E
            CALL     sd_cmd8               ; 00F  CMD8 (SEND_IF_COND 1AA)
            CALL     sd_get_resp           ; 010
            FETCH    s0, 05                ; 011  echoed check pattern
            FETCH    s0, 05                ; 012
            COMPARE  s0, AA                ; 013  AA = card understood CMD8
            JUMP     NZ, init_acmd41       ; 014
            LOAD     s0, 02                ; 015  scratch 01 = 2: SD version 2 card
            STORE    s0, 01                ; 016
            JUMP     init_acmd41           ; 017
init_acmd41:
            CALL     sd_wait_ready         ; 018  CMD55/ACMD41 until ready
            CALL     sd_cmd2               ; 019  CMD2 (ALL_SEND_CID)
            CALL     sd_save_cid           ; 01A  keep CID word
            CALL     delay_s               ; 01B
            CALL     sd_cmd3               ; 01C  CMD3 (SEND_RELATIVE_ADDR)
            CALL     delay_m               ; 01D
            CALL     sd_get_resp           ; 01E
            FETCH    s0, 02                ; 01F  RCA = response bits 31:16
            STORE    s0, 17                ; 020
            FETCH    s0, 03                ; 021
            STORE    s0, 18                ; 022
            LOAD     s0, 00                ; 023  clock divider 0: full speed
            CALL     sdc_set_clkdiv        ; 024
            CALL     sdc_reset_off         ; 025  software reset register = 0
            CALL     sd_cmd7               ; 026  CMD7 (SELECT_CARD)
            LOAD     s1, 02                ; 027
            LOAD     s0, 00                ; 028
            CALL     sd_cmd16              ; 029  CMD16 SET_BLOCKLEN 512
            CALL     sd_cmd55              ; 02A  CMD55
            CALL     sd_acmd6              ; 02B  ACMD6: 4-bit bus
            CALL     sdc_bus4              ; 02C  controller: 4-bit bus
            CALL     sd_cmd13              ; 02D  CMD13
            CALL     rtc_init              ; 02E  PCF8563 init
            LOAD     sF, EE                ; 02F  debug EE: init done
            CALL     dbg_putc              ; 030
            ENABLE INTERRUPT               ; 031

; ------------------------------------------------------------------------------
; MAIN LOOP: while the Game Boy has the RTC window mapped (B9 = 01), keep copying
; the PCF8563 time into it. All Game Boy commands arrive as interrupts (isr).
; ------------------------------------------------------------------------------
main_loop:
            INPUT    s1, B9                ; 032  RTC window mapped?
            COMPARE  s1, 01                ; 033
            JUMP     NZ, main_idle         ; 034
            LOAD     sB, 02                ; 035  start at register 2 (seconds)
            DISABLE INTERRUPT              ; 036  no interrupts during the I2C burst
            CALL     rtc_publish           ; 037
            ENABLE INTERRUPT               ; 038
main_idle:
            CALL     delay_l               ; 039  pause, then poll again
            JUMP     main_loop             ; 03A

; Unreachable: pulse output port F2.
            CALL     delay_s               ; 03B  [unreachable]
            LOAD     s1, 00                ; 03C  [unreachable]
            OUTPUT   s1, F2                ; 03D  [unreachable]
            LOAD     s2, 01                ; 03E  [unreachable]
            OUTPUT   s2, F2                ; 03F  [unreachable]
            OUTPUT   s1, F2                ; 040  [unreachable]
            RETURN                         ; 041  [unreachable]

; clear_scratch: zero scratchpad 00-3D (3E/3F, the licence flags, survive).
clear_scratch:
            LOAD     s6, 00                ; 042
            LOAD     s4, 00                ; 043
clear_scratch_L02:
            COMPARE  s4, 3E                ; 044
            JUMP     C, clear_scratch_L05  ; 045
            JUMP     clear_scratch_L08     ; 046
clear_scratch_L05:
            STORE    s6, (s4)              ; 047
            ADD      s4, 01                ; 048
            JUMP     clear_scratch_L02     ; 049
clear_scratch_L08:
            RETURN                         ; 04A

; ------------------------------------------------------------------------------
; SD COMMAND WRAPPERS. Each loads sC = command index, sB = response flags,
; s7-sA = argument (s7 = LSB) and falls into sd_cmd.
; ------------------------------------------------------------------------------
; sd_cmd0: GO_IDLE_STATE, no response.
sd_cmd0:
            LOAD     sC, 00                ; 04B
            LOAD     sB, 00                ; 04C
            JUMP     sd_cmd_noarg          ; 04D

; sd_cmd8: SEND_IF_COND, argument 000001AA (2.7-3.6 V, check pattern AA), R7.
sd_cmd8:
            LOAD     sC, 08                ; 04E
            LOAD     sB, 15                ; 04F
            LOAD     s8, 01                ; 050  argument 000001AA
            LOAD     s7, AA                ; 051
            JUMP     sd_cmd_arg16          ; 052

; sd_wait_ready: repeat CMD55 + ACMD41 until the card reports power-up done
; (OCR bit 31), at most 255 tries. Sets scratch 06 = 01 for a high-capacity card
; (OCR bit 30, CCS); debug byte 82 = SDHC/SDXC, 88 = SDSC or timeout.
sd_wait_ready:
            LOAD     s3, FF                ; 053  up to 255 attempts
            STORE    s3, 00                ; 054
            LOAD     s0, 00                ; 055
            STORE    s0, 17                ; 056
            STORE    s0, 18                ; 057
acmd41_retry:
            CALL     sd_cmd55              ; 058
            CALL     delay_s               ; 059
            CALL     sd_acmd41             ; 05A
            CALL     delay_s               ; 05B
            CALL     sd_get_resp           ; 05C
            FETCH    s0, 02                ; 05D  OCR bits 31:24
            TEST     s0, 80                ; 05E  bit 31: power-up done
            JUMP     NZ, acmd41_ready      ; 05F
            FETCH    s3, 00                ; 060  not ready: count down
            SUB      s3, 01                ; 061
            STORE    s3, 00                ; 062
            COMPARE  s3, 00                ; 063
            JUMP     Z, acmd41_sdsc        ; 064  gave up
            CALL     delay_l               ; 065
            JUMP     acmd41_retry          ; 066
acmd41_ready:
            FETCH    s0, 01                ; 067
            COMPARE  s0, 02                ; 068
            JUMP     Z, acmd41_ready_L05   ; 069
            LOAD     s0, 01                ; 06A  not v2: scratch 01 = 1
            STORE    s0, 01                ; 06B
acmd41_ready_L05:
            FETCH    s0, 02                ; 06C
            TEST     s0, 40                ; 06D  bit 30: CCS (high capacity)
            JUMP     Z, acmd41_sdsc        ; 06E
            LOAD     s3, 01                ; 06F  high capacity
            LOAD     sF, 82                ; 070  debug 82
            CALL     dbg_putc              ; 071
            JUMP     acmd41_done           ; 072
acmd41_sdsc:
            LOAD     sF, 88                ; 073  debug 88
            CALL     dbg_putc              ; 074
            LOAD     s3, 00                ; 075  standard capacity
acmd41_done:
            STORE    s3, 06                ; 076  scratch 06 = capacity flag
            RETURN                         ; 077

; sd_cmd55: APP_CMD with the card's RCA (R1).
sd_cmd55:
            LOAD     sC, 37                ; 078  CMD55
sd_cmd_rca:
            LOAD     sB, 15                ; 079
            FETCH    sA, 17                ; 07A  argument = RCA << 16
            FETCH    s9, 18                ; 07B
            JUMP     sd_cmd_arg_hi         ; 07C

; sd_cmd13: SEND_STATUS with RCA (R1).
sd_cmd13:
            LOAD     sC, 0D                ; 07D  CMD13
            JUMP     sd_cmd_rca            ; 07E

; sd_acmd41: SD_SEND_OP_COND, argument 40300000 (HCS + 3.2-3.4 V), R3.
; The OR at 085 is overwritten by the LOAD at 086, so HCS is always set.
sd_acmd41:
            LOAD     sC, 29                ; 07F  ACMD41 (index 29)
            LOAD     sB, 01                ; 080  R3: response, no CRC check
            LOAD     sA, 00                ; 081
            FETCH    s0, 01                ; 082
            COMPARE  s0, 02                ; 083
            JUMP     NZ, sd_acmd41_L07     ; 084
            OR       sA, 40                ; 085  (dead: overwritten below)
sd_acmd41_L07:
            LOAD     sA, 40                ; 086  argument 4030_0000
            LOAD     s9, 30                ; 087
sd_cmd_arg_hi:
            LOAD     s8, 00                ; 088
            LOAD     s7, 00                ; 089
            CALL     sd_cmd                ; 08A
            RETURN                         ; 08B

; sd_cmd2: ALL_SEND_CID, R2 (136-bit).
sd_cmd2:
            LOAD     sC, 02                ; 08C  CMD2
            LOAD     sB, 07                ; 08D  R2 (136-bit, CRC)
            JUMP     sd_cmd_noarg          ; 08E

; sd_cmd3: SEND_RELATIVE_ADDR, R6.
sd_cmd3:
            LOAD     sC, 03                ; 08F  CMD3
            LOAD     sB, 15                ; 090
            JUMP     sd_cmd_noarg          ; 091

; sd_cmd7: SELECT_CARD with RCA, R1.
sd_cmd7:
            LOAD     sC, 07                ; 092  CMD7
            LOAD     sB, 15                ; 093
            FETCH    sA, 17                ; 094
            FETCH    s9, 18                ; 095
            JUMP     sd_cmd_arg_hi         ; 096

; sd_acmd6: SET_BUS_WIDTH, argument 2 (4-bit). Sent after CMD55.
sd_acmd6:
            LOAD     sC, 06                ; 097  ACMD6
            LOAD     sB, 15                ; 098
            LOAD     s8, 00                ; 099
            LOAD     s7, 02                ; 09A  argument 2: 4-bit bus
            JUMP     sd_cmd_arg16          ; 09B

; sd_cmd16: SET_BLOCKLEN, argument s1:s0 (called with 0200).
sd_cmd16:
            LOAD     sC, 10                ; 09C  CMD16
            LOAD     sB, 15                ; 09D
            LOAD     s8, s1                ; 09E
            LOAD     s7, s0                ; 09F
            JUMP     sd_cmd_arg16          ; 0A0
sd_cmd_noarg:
            LOAD     s8, 00                ; 0A1
            LOAD     s7, 00                ; 0A2
sd_cmd_arg16:
            LOAD     sA, 00                ; 0A3
            LOAD     s9, 00                ; 0A4
            CALL     sd_cmd                ; 0A5
            RETURN                         ; 0A6

; ------------------------------------------------------------------------------
; sdc_init_regs: initial SD host controller setup: clear timeouts and event
; enables/status, 1-bit bus, pulse software reset, clock divider 48 (slow
; clock for card identification).
; ------------------------------------------------------------------------------
sdc_init_regs:
            CALL     sdc_reg20_clear       ; 0A7  reg 20 = 0
            CALL     sdc_reg18_clear       ; 0A8  reg 18 = 0
            CALL     sdc_reg38_clear       ; 0A9  reg 38 = 0 (cmd events off)
            CALL     sdc_reg40_clear       ; 0AA  reg 40 = 0 (data events off)
            CALL     sdc_reg34_clear       ; 0AB  reg 34 = 0 (clear cmd events)
            CALL     sdc_reg3C_clear       ; 0AC  reg 3C = 0 (clear data events)
            LOAD     s0, 00                ; 0AD
            CALL     sdc_set_clkdiv        ; 0AE  reg 24 = 0
            CALL     sdc_bus1              ; 0AF  reg 1C = 0: 1-bit bus
            CALL     sdc_reset_on          ; 0B0  reg 28 = 1: reset
            LOAD     s0, 48                ; 0B1  clock divider 48: slow identification clock
            CALL     sdc_set_clkdiv        ; 0B2
            CALL     sdc_reset_off         ; 0B3  reg 28 = 0: release reset
            RETURN                         ; 0B4
sdc_reset_on:
            LOAD     sE, 28                ; 0B5
            CALL     wb_clear_hi           ; 0B6
            JUMP     wb_write_1            ; 0B7
sdc_reg20_clear:
            LOAD     sE, 20                ; 0B8
            LOAD     sD, 00                ; 0B9
            OUTPUT   sD, 73                ; 0BA
            OUTPUT   sD, 72                ; 0BB
            LOAD     s1, 00                ; 0BC
            OUTPUT   s1, 71                ; 0BD
            OUTPUT   s1, 70                ; 0BE
            CALL     wb_write              ; 0BF
            RETURN                         ; 0C0
sdc_reg18_clear:
            LOAD     sE, 18                ; 0C1
            JUMP     wb_write_0            ; 0C2
sdc_set_clkdiv:
            LOAD     sE, 24                ; 0C3
            CALL     wb_clear_hi           ; 0C4
            LOAD     sD, s0                ; 0C5
            OUTPUT   sD, 70                ; 0C6
            CALL     wb_write              ; 0C7
            RETURN                         ; 0C8
sdc_reset_off:
            LOAD     sE, 28                ; 0C9
            JUMP     wb_write_0            ; 0CA
sdc_reg38_clear:
            LOAD     sE, 38                ; 0CB
            JUMP     wb_write_0            ; 0CC
sdc_reg34_clear:
            LOAD     sE, 34                ; 0CD
            JUMP     wb_write_0            ; 0CE
sdc_reg40_set:
            LOAD     sE, 40                ; 0CF
            CALL     wb_clear_hi           ; 0D0
            JUMP     wb_write_1            ; 0D1
sdc_reg40_clear:
            LOAD     sE, 40                ; 0D2
            JUMP     wb_write_0            ; 0D3
sdc_reg3C_clear:
            LOAD     sE, 3C                ; 0D4
            JUMP     wb_write_0            ; 0D5
sdc_bus4:
            LOAD     sE, 1C                ; 0D6
            CALL     wb_clear_hi           ; 0D7

; wb_write_1 / wb_write_0: write 00000001 / 00000000 to Wishbone register sE.
wb_write_1:
            LOAD     s1, 01                ; 0D8
            OUTPUT   s1, 70                ; 0D9
            CALL     wb_write              ; 0DA
            RETURN                         ; 0DB
sdc_bus1:
            LOAD     sE, 1C                ; 0DC
            JUMP     wb_write_0            ; 0DD
wb_write_0:
            CALL     wb_clear_hi           ; 0DE
            OUTPUT   sD, 70                ; 0DF
            CALL     wb_write              ; 0E0
            RETURN                         ; 0E1

; wb_clear_hi: zero the upper three staging bytes (ports 71-73); sD = 0.
wb_clear_hi:
            LOAD     sD, 00                ; 0E2
            OUTPUT   sD, 73                ; 0E3
            OUTPUT   sD, 72                ; 0E4
            OUTPUT   sD, 71                ; 0E5
            RETURN                         ; 0E6

; ------------------------------------------------------------------------------
; sd_cmd: send SD command.
;   in: sC = index, sB = flags (see header), s7-sA = argument (s7 = LSB),
;       scratch 19 = data phase (01 read, 02 write, 00 none),
;       1A-1D = DMA address, 1E-1F = block size - 1, 20 = block count - 1.
; Builds the controller's command word in s0, programs the data registers if a
; data phase is requested, issues the command, waits for the command event,
; then (for data commands) waits for the data event.
; ------------------------------------------------------------------------------
sd_cmd:
            LOAD     s0, 00                ; 0E7
            TEST     sB, 01                ; 0E8  b0: response expected
            JUMP     Z, sd_cmd_L08         ; 0E9
            TEST     sB, 02                ; 0EA  b1: long response
            JUMP     Z, sd_cmd_L07         ; 0EB
            OR       s0, 02                ; 0EC  -> 136-bit
            JUMP     sd_cmd_L08            ; 0ED
sd_cmd_L07:
            OR       s0, 01                ; 0EE  -> 48-bit
sd_cmd_L08:
            TEST     sB, 08                ; 0EF  sB b3 -> busy check
            JUMP     Z, sd_cmd_L0B         ; 0F0
            OR       s0, 04                ; 0F1
sd_cmd_L0B:
            TEST     sB, 04                ; 0F2  sB b2 -> CRC check
            JUMP     Z, sd_cmd_L0E         ; 0F3
            OR       s0, 08                ; 0F4
sd_cmd_L0E:
            TEST     sB, 10                ; 0F5  sB b4 -> index check
            JUMP     Z, sd_cmd_L11         ; 0F6
            OR       s0, 10                ; 0F7
sd_cmd_L11:
            FETCH    s1, 19                ; 0F8  data phase?
            COMPARE  s1, 01                ; 0F9
            JUMP     NZ, sd_cmd_L16        ; 0FA
            OR       s0, 20                ; 0FB  read data
            JUMP     sd_cmd_data           ; 0FC
sd_cmd_L16:
            COMPARE  s1, 02                ; 0FD
            JUMP     NZ, sd_cmd_issue      ; 0FE
            OR       s0, 40                ; 0FF  write data
sd_cmd_data:
            LOAD     sE, 60                ; 100  reg 60: DMA address from scratch 1A-1D
            FETCH    s1, 1A                ; 101
            OUTPUT   s1, 73                ; 102
            FETCH    s1, 1B                ; 103
            OUTPUT   s1, 72                ; 104
            FETCH    s1, 1C                ; 105
            OUTPUT   s1, 71                ; 106
            FETCH    s1, 1D                ; 107
            OUTPUT   s1, 70                ; 108
            CALL     wb_write              ; 109
            LOAD     sE, 44                ; 10A  reg 44: block size - 1
            LOAD     s1, 00                ; 10B
            OUTPUT   s1, 73                ; 10C
            OUTPUT   s1, 72                ; 10D
            FETCH    s1, 1E                ; 10E
            OUTPUT   s1, 71                ; 10F
            FETCH    s1, 1F                ; 110
            OUTPUT   s1, 70                ; 111
            CALL     wb_write              ; 112
            LOAD     sE, 48                ; 113  reg 48: block count - 1
            CALL     wb_clear_hi           ; 114
            FETCH    s1, 20                ; 115
            OUTPUT   s1, 70                ; 116
            CALL     wb_write              ; 117
sd_cmd_issue:
            LOAD     sE, 04                ; 118  reg 04: command (index, flags)
            OUTPUT   sC, 71                ; 119
            OUTPUT   s0, 70                ; 11A
            CALL     wb_write              ; 11B
            LOAD     sE, 00                ; 11C  reg 00: argument; this starts the command
            OUTPUT   sA, 73                ; 11D
            OUTPUT   s9, 72                ; 11E
            OUTPUT   s8, 71                ; 11F
            OUTPUT   s7, 70                ; 120
            CALL     wb_write              ; 121
sd_cmd_wait:
            LOAD     sE, 34                ; 122  wait for command event
            CALL     wb_wait_ack           ; 123
            INPUT    s0, 70                ; 124
            COMPARE  s0, 06                ; 125  06: error bits
            JUMP     Z, sd_cmd_done        ; 126
            TEST     s0, 01                ; 127  b0: command complete
            JUMP     Z, sd_cmd_wait        ; 128
sd_cmd_done:
            LOAD     sE, 34                ; 129  clear command events
            LOAD     sD, 00                ; 12A
            OUTPUT   sD, 70                ; 12B
            CALL     wb_write              ; 12C
            FETCH    s1, 19                ; 12D  data phase?
            COMPARE  s1, 00                ; 12E
            JUMP     Z, sd_cmd_ret         ; 12F
            LOAD     sF, 55                ; 130  debug 55
            CALL     dbg_putc              ; 131
sd_data_wait:
            LOAD     sE, 3C                ; 132  wait for data event (b0 = transfer complete)
            CALL     wb_wait_ack           ; 133
            INPUT    s3, 70                ; 134
            TEST     s3, 01                ; 135
            JUMP     Z, sd_data_wait       ; 136
            STORE    s3, 3D                ; 137  keep data status
            LOAD     sE, 3C                ; 138  clear data events
            LOAD     sD, 00                ; 139
            OUTPUT   sD, 70                ; 13A
            CALL     wb_write              ; 13B
            LOAD     s1, 00                ; 13C  data phase done
            STORE    s1, 19                ; 13D
sd_cmd_ret:
            RETURN                         ; 13E

; sd_get_resp: read response register 08 into scratch 02-05 (02 = MSB).
sd_get_resp:
            LOAD     sE, 08                ; 13F  register 08 = response
            JUMP     sd_get_resp_L02       ; 140
sd_get_resp_L02:
            CALL     wb_wait_ack           ; 141
            INPUT    s6, 73                ; 142
            STORE    s6, 02                ; 143
            INPUT    s5, 72                ; 144
            STORE    s5, 03                ; 145
            INPUT    s4, 71                ; 146
            STORE    s4, 04                ; 147
            INPUT    s3, 70                ; 148
            STORE    s3, 05                ; 149
            RETURN                         ; 14A

; sd_save_cid: read the response and copy it to scratch 13-16.
sd_save_cid:
            CALL     sd_get_resp           ; 14B
            FETCH    s0, 05                ; 14C
            STORE    s0, 16                ; 14D
            FETCH    s0, 04                ; 14E
            STORE    s0, 15                ; 14F
            FETCH    s0, 03                ; 150
            STORE    s0, 14                ; 151
            FETCH    s0, 02                ; 152
            STORE    s0, 13                ; 153
            RETURN                         ; 154

; ------------------------------------------------------------------------------
; dbg_putc: send sF to the debug output (port A1) once A0 bit 2 is clear.
; Probably a UART or similar; the codes it sends are progress markers.
; ------------------------------------------------------------------------------
dbg_putc:
            INPUT    s0, A0                ; 155  debug TX busy?
            TEST     s0, 04                ; 156
            JUMP     NZ, dbg_putc          ; 157
            OUTPUT   sF, A1                ; 158  send byte
            RETURN                         ; 159

; wb_write: write the 32-bit value staged in ports 70-73 to Wishbone register
; sE (the port number is the register address), then wait for the ack.
; wb_wait_ack: wait until reading register sE returns b1:0 != 0 (also used on
; its own to start a register read; data then appears on input ports 70-73).
wb_write:
            OUTPUT   sD, (sE)              ; 15A  start write cycle to register sE
            JUMP     wb_wait_ack           ; 15B
wb_wait_ack:
            INPUT    sD, (sE)              ; 15C  read register sE
            TEST     sD, 03                ; 15D  ack/done bits
            JUMP     Z, wb_wait_ack        ; 15E
            RETURN                         ; 15F

; ------------------------------------------------------------------------------
; DELAYS (nested countdown loops; instruction counts measured by emulation):
;   delay_s  ~1.1k instr   delay_m ~27k   delay_l ~543k   delay_l_half ~271k
; ------------------------------------------------------------------------------
delay_tiny:
            LOAD     s0, 03                ; 160  [unreachable]
delay_tiny_L01:
            SUB      s0, 01                ; 161  [unreachable]
            JUMP     NZ, delay_tiny_L01    ; 162  [unreachable]
            RETURN                         ; 163  [unreachable]
delay_11:
            LOAD     s0, 0B                ; 164
delay_11_L01:
            SUB      s0, 01                ; 165
            JUMP     NZ, delay_11_L01      ; 166
            RETURN                         ; 167
delay_s:
            LOAD     s1, 28                ; 168
delay_s_L01:
            CALL     delay_11              ; 169
            SUB      s1, 01                ; 16A
            JUMP     NZ, delay_s_L01       ; 16B
            RETURN                         ; 16C
delay_m:
            LOAD     s2, 19                ; 16D
delay_m_L01:
            CALL     delay_s               ; 16E
            SUB      s2, 01                ; 16F
            JUMP     NZ, delay_m_L01       ; 170
            RETURN                         ; 171
delay_l:
            LOAD     s3, 14                ; 172
delay_l_L01:
            CALL     delay_m               ; 173
            SUB      s3, 01                ; 174
            JUMP     NZ, delay_l_L01       ; 175
            RETURN                         ; 176
delay_l_half:
            LOAD     s3, 0A                ; 177  [unreachable]
delay_l_half_L01:
            CALL     delay_m               ; 178  [unreachable]
            SUB      s3, 01                ; 179  [unreachable]
            JUMP     NZ, delay_l_half_L01  ; 17A  [unreachable]
            RETURN                         ; 17B  [unreachable]
delay_xl:
            LOAD     s4, 19                ; 17C  [unreachable]
delay_xl_L01:
            CALL     delay_l               ; 17D  [unreachable]
            SUB      s4, 01                ; 17E  [unreachable]
            JUMP     NZ, delay_xl_L01      ; 17F  [unreachable]
            RETURN                         ; 180  [unreachable]

; ------------------------------------------------------------------------------
; SECTOR TRANSFERS. In: s7-sA = card address, scratch 20 = block count - 1.
; DMA address = 0, i.e. the start of the 2 KB sector buffer the Game Boy sees
; at $A000 ($7F30 = 01).
; sd_read_multi:  CMD18 READ_MULTIPLE_BLOCK
; sd_write_multi: CMD25 WRITE_MULTIPLE_BLOCK
; sd_write_single: CMD24 (only reachable via fall-through, unused)
; ------------------------------------------------------------------------------
sd_read_multi:
            LOAD     sC, 12                ; 181  CMD18
            LOAD     s1, 01                ; 182  data phase: read
sd_xfer_dir:
            STORE    s1, 19                ; 183
            CALL     sd_xfer_start         ; 184
            RETURN                         ; 185
sd_write_single:
            LOAD     sC, 18                ; 186  [unreachable] CMD24
sd_write_single_L01:
            LOAD     s1, 02                ; 187  data phase: write
            JUMP     sd_xfer_dir           ; 188
sd_write_multi:
            LOAD     sC, 19                ; 189  CMD25
            JUMP     sd_write_single_L01   ; 18A

; sd_xfer_start: DMA address 0, block size 512, enable data events, then send
; the command with an R1 response. Debug: 99 followed by the 4 address bytes.
sd_xfer_start:
            LOAD     s1, 00                ; 18B
            STORE    s1, 1C                ; 18C  DMA address = 0
            STORE    s1, 1A                ; 18D
            STORE    s1, 1B                ; 18E
            STORE    s1, 1D                ; 18F
            LOAD     s1, 01                ; 190  block size - 1 = 01FF
            STORE    s1, 1E                ; 191
            LOAD     s1, FF                ; 192
            STORE    s1, 1F                ; 193
            FETCH    s1, 20                ; 194
            CALL     sdc_reg40_set         ; 195  reg 40 = 1: data events on
            LOAD     sB, 15                ; 196  R1
            LOAD     sF, 99                ; 197  debug 99, then the address bytes
            CALL     dbg_putc              ; 198
            LOAD     sF, sA                ; 199
            CALL     dbg_putc              ; 19A
            LOAD     sF, s9                ; 19B
            CALL     dbg_putc              ; 19C
            LOAD     sF, s8                ; 19D
            CALL     dbg_putc              ; 19E
            LOAD     sF, s7                ; 19F
            CALL     dbg_putc              ; 1A0
            CALL     sd_cmd                ; 1A1
            RETURN                         ; 1A2

; sd_cmd12: STOP_TRANSMISSION, R1b.
sd_cmd12:
            LOAD     sC, 0C                ; 1A3  CMD12
            LOAD     sB, 1D                ; 1A4  R1b
            CALL     sd_cmd_noarg          ; 1A5
            RETURN                         ; 1A6

; ------------------------------------------------------------------------------
; rom_load (event 20, Game Boy $7F36 = 03): load a file from the SD card into the
; cartridge memory, following the 512-byte load table.
; Gate: scratch 3E/3F must be F1/F2 (set by the bank-1 licence check).
; Table words (via table_read): 7E = sectors per cluster, 7D must be 1,
; 7C = file size in bytes, 00.. = {file sector offset, LBA} pairs.
; Port EF = 1 while loading. Each step: tell the destination logic which file
; sector comes next (E0-E3), map the file sector to an LBA (map_sector), read
; one cluster with CMD18 into the cartridge memory, CMD12, then wait (delay_l).
; ------------------------------------------------------------------------------
rom_load:
            FETCH    sF, 3E                ; 1A7  debug: licence flags
            CALL     dbg_putc              ; 1A8
            FETCH    sF, 3F                ; 1A9
            CALL     dbg_putc              ; 1AA
            FETCH    s0, 3E                ; 1AB  licensed?
            COMPARE  s0, F1                ; 1AC
            RETURN NZ                      ; 1AD
            FETCH    s0, 3F                ; 1AE
            COMPARE  s0, F2                ; 1AF
            RETURN NZ                      ; 1B0
            LOAD     s5, 7E                ; 1B1  table word 7E: sectors per cluster
            CALL     table_read            ; 1B2
            STORE    s0, 2A                ; 1B3
            STORE    s1, 31                ; 1B4
            SUB      s0, 01                ; 1B5  block count - 1 = one cluster
            STORE    s0, 20                ; 1B6
            LOAD     s5, 7D                ; 1B7  table word 7D must be 1
            CALL     table_read            ; 1B8
            COMPARE  s0, 01                ; 1B9
            JUMP     Z, rom_load_go        ; 1BA
            RETURN                         ; 1BB
rom_load_go:
            LOAD     s0, 01                ; 1BC  busy flag for the GB-visible status
            OUTPUT   s0, EF                ; 1BD
            CALL     rom_load_file         ; 1BE
            LOAD     s0, 00                ; 1BF  done
            OUTPUT   s0, EF                ; 1C0
            RETURN                         ; 1C1
rom_load_file:
            LOAD     s0, 00                ; 1C2  start at file sector 0
            STORE    s0, 2C                ; 1C3
            STORE    s0, 2D                ; 1C4
            STORE    s0, 2E                ; 1C5
            STORE    s0, 2F                ; 1C6
            LOAD     s1, 00                ; 1C7  load-table page 0
            STORE    s1, 3B                ; 1C8
rom_load_cluster:
            FETCH    s7, 2F                ; 1C9  tell the destination which file sector comes next
            OUTPUT   s7, E0                ; 1CA
            FETCH    s8, 2E                ; 1CB
            OUTPUT   s8, E1                ; 1CC
            FETCH    s9, 2D                ; 1CD
            OUTPUT   s9, E2                ; 1CE
            FETCH    sA, 2C                ; 1CF
            OUTPUT   sA, E3                ; 1D0
            CALL     map_sector            ; 1D1  file sector -> card address
            CALL     sd_read_multi         ; 1D2  read one cluster
            CALL     sd_cmd12              ; 1D3  stop
            CALL     delay_l               ; 1D4  wait (lets the cluster drain into cartridge memory?)
            FETCH    s7, 2F                ; 1D5  file sector += sectors per cluster
            FETCH    s8, 2E                ; 1D6
            FETCH    s9, 2D                ; 1D7
            FETCH    sA, 2C                ; 1D8
            FETCH    s0, 2A                ; 1D9
            FETCH    s1, 31                ; 1DA
            ADD      s7, s0                ; 1DB
            ADDCY    s8, s1                ; 1DC
            ADDCY    s9, 00                ; 1DD
            ADDCY    sA, 00                ; 1DE
            STORE    s7, 2F                ; 1DF
            STORE    s8, 2E                ; 1E0
            STORE    s9, 2D                ; 1E1
            STORE    sA, 2C                ; 1E2
            LOAD     s5, 7C                ; 1E3  table word 7C: file size
            CALL     table_read            ; 1E4
            SL0      s7                    ; 1E5  file sector * 2 < size / 256  <=>  file sector * 512 < size
            SLA      s8                    ; 1E6
            SLA      s9                    ; 1E7
            SLA      sA                    ; 1E8
            SUB      s7, s1                ; 1E9
            SUBCY    s8, s2                ; 1EA
            SUBCY    s9, s3                ; 1EB
            JUMP     C, rom_load_cluster   ; 1EC  more to load
            RETURN                         ; 1ED

; ------------------------------------------------------------------------------
; UNREACHABLE (1EE-289): older code driving a 24-bit address (E4-E6) and
; control port (E7) in loops of 400h/800h steps: probably a copy/clear of the
; save RAM or PSRAM from an earlier design. Nothing calls it; removed in FW5.
; ------------------------------------------------------------------------------
old_wait_b7:
            INPUT    s1, B7                ; 1EE  [unreachable]
            COMPARE  s1, 00                ; 1EF  [unreachable]
            JUMP     Z, old_wait_b7        ; 1F0  [unreachable]
            LOAD     sF, AA                ; 1F1  [unreachable]
            CALL     dbg_putc              ; 1F2  [unreachable]
            LOAD     s4, 03                ; 1F3  [unreachable]
            STORE    s4, 20                ; 1F4  [unreachable]
            LOAD     s4, 01                ; 1F5  [unreachable]
            OUTPUT   s4, E7                ; 1F6  [unreachable]
            LOAD     s4, 00                ; 1F7  [unreachable]
            STORE    s4, 33                ; 1F8  [unreachable]
            STORE    s4, 34                ; 1F9  [unreachable]
            STORE    s4, 35                ; 1FA  [unreachable]
            STORE    s4, 36                ; 1FB  [unreachable]
            RETURN                         ; 1FC  [unreachable]
old_bus_fill:
            LOAD     s0, 00                ; 1FD  [unreachable]
            LOAD     s1, 00                ; 1FE  [unreachable]
            LOAD     s2, 00                ; 1FF  [unreachable]
old_bus_fill_L03:
            FETCH    s4, 38                ; 200  [unreachable]
            FETCH    s5, 39                ; 201  [unreachable]
            ADD      s4, s1                ; 202  [unreachable]
            ADDCY    s5, s2                ; 203  [unreachable]
            OUTPUT   s5, E6                ; 204  [unreachable]
            OUTPUT   s4, E5                ; 205  [unreachable]
            OUTPUT   s0, E4                ; 206  [unreachable]
            LOAD     s6, 03                ; 207  [unreachable]
            OUTPUT   s6, E7                ; 208  [unreachable]
            LOAD     s6, 01                ; 209  [unreachable]
            OUTPUT   s6, E7                ; 20A  [unreachable]
            ADD      s0, 01                ; 20B  [unreachable]
            ADDCY    s1, 00                ; 20C  [unreachable]
            COMPARE  s1, 04                ; 20D  [unreachable]
            JUMP     Z, old_bus_fill_L13   ; 20E  [unreachable]
            JUMP     old_bus_fill_L03      ; 20F  [unreachable]
old_bus_fill_L13:
            RETURN                         ; 210  [unreachable]
old_get_33:
            FETCH    s7, 33                ; 211  [unreachable]
            FETCH    s8, 34                ; 212  [unreachable]
            FETCH    s9, 35                ; 213  [unreachable]
            FETCH    sA, 36                ; 214  [unreachable]
            RETURN                         ; 215  [unreachable]
old_step:
            CALL     old_bus_fill          ; 216  [unreachable]
            FETCH    s1, 38                ; 217  [unreachable]
            FETCH    s2, 39                ; 218  [unreachable]
            ADD      s1, 04                ; 219  [unreachable]
            ADDCY    s2, 00                ; 21A  [unreachable]
            STORE    s1, 38                ; 21B  [unreachable]
            STORE    s2, 39                ; 21C  [unreachable]
            CALL     old_get_33            ; 21D  [unreachable]
            CALL     map_sector            ; 21E  [unreachable]
            COMPARE  s7, 00                ; 21F  [unreachable]
            JUMP     NZ, old_step_L12      ; 220  [unreachable]
            COMPARE  s8, 00                ; 221  [unreachable]
            JUMP     NZ, old_step_L12      ; 222  [unreachable]
            COMPARE  s9, 00                ; 223  [unreachable]
            JUMP     NZ, old_step_L12      ; 224  [unreachable]
            COMPARE  sA, 00                ; 225  [unreachable]
            JUMP     NZ, old_step_L12      ; 226  [unreachable]
            RETURN                         ; 227  [unreachable]
old_step_L12:
            CALL     sd_write_multi        ; 228  [unreachable]
            CALL     sd_cmd12              ; 229  [unreachable]
            CALL     old_get_33            ; 22A  [unreachable]
            ADD      s7, 04                ; 22B  [unreachable]
            ADDCY    s8, 00                ; 22C  [unreachable]
            ADDCY    s9, 00                ; 22D  [unreachable]
            ADDCY    sA, 00                ; 22E  [unreachable]
            STORE    s7, 33                ; 22F  [unreachable]
            STORE    s8, 34                ; 230  [unreachable]
            STORE    s9, 35                ; 231  [unreachable]
            STORE    sA, 36                ; 232  [unreachable]
            RETURN                         ; 233  [unreachable]
old_copy_a:
            CALL     old_wait_b7           ; 234  [unreachable]
            STORE    s4, 39                ; 235  [unreachable]
            STORE    s4, 38                ; 236  [unreachable]
            STORE    s4, 37                ; 237  [unreachable]
            LOAD     s1, FF                ; 238  [unreachable]
            STORE    s1, 3B                ; 239  [unreachable]
old_copy_a_L06:
            CALL     old_step              ; 23A  [unreachable]
            LOAD     s5, 7F                ; 23B  [unreachable]
            CALL     table_read            ; 23C  [unreachable]
            SL0      s7                    ; 23D  [unreachable]
            SLA      s8                    ; 23E  [unreachable]
            SLA      s9                    ; 23F  [unreachable]
            SLA      sA                    ; 240  [unreachable]
            SUB      s7, s1                ; 241  [unreachable]
            SUBCY    s8, s2                ; 242  [unreachable]
            SUBCY    s9, 00                ; 243  [unreachable]
            JUMP     C, old_copy_a_L06     ; 244  [unreachable]
            LOAD     s4, 00                ; 245  [unreachable]
            OUTPUT   s4, E7                ; 246  [unreachable]
            LOAD     sF, DF                ; 247  [unreachable]
            CALL     dbg_putc              ; 248  [unreachable]
            RETURN                         ; 249  [unreachable]
old_copy_b:
            CALL     old_wait_b7           ; 24A  [unreachable]
            STORE    s4, 37                ; 24B  [unreachable]
            STORE    s4, 38                ; 24C  [unreachable]
            LOAD     s4, 02                ; 24D  [unreachable]
            STORE    s4, 39                ; 24E  [unreachable]
            LOAD     s1, F3                ; 24F  [unreachable]
            STORE    s1, 3B                ; 250  [unreachable]
old_copy_b_L07:
            CALL     old_step              ; 251  [unreachable]
            LOAD     s0, 00                ; 252  [unreachable]
            LOAD     s1, 00                ; 253  [unreachable]
            LOAD     s2, 07                ; 254  [unreachable]
            LOAD     s3, 00                ; 255  [unreachable]
            SL0      s7                    ; 256  [unreachable]
            SLA      s8                    ; 257  [unreachable]
            SLA      s9                    ; 258  [unreachable]
            SLA      sA                    ; 259  [unreachable]
            SUB      s7, s1                ; 25A  [unreachable]
            SUBCY    s8, s2                ; 25B  [unreachable]
            SUBCY    s9, 00                ; 25C  [unreachable]
            JUMP     C, old_copy_b_L07     ; 25D  [unreachable]
            LOAD     s4, 00                ; 25E  [unreachable]
            OUTPUT   s4, E7                ; 25F  [unreachable]
            LOAD     sF, DA                ; 260  [unreachable]
            CALL     dbg_putc              ; 261  [unreachable]
            RETURN                         ; 262  [unreachable]
old_copy_c:
            INPUT    s5, A2                ; 263  [unreachable]
            INPUT    s6, A3                ; 264  [unreachable]
            COMPARE  s0, EF                ; 265  [unreachable]
            JUMP     NZ, old_copy_c_L06    ; 266  [unreachable]
            LOAD     s5, 00                ; 267  [unreachable]
            LOAD     s6, 00                ; 268  [unreachable]
old_copy_c_L06:
            LOAD     s4, 01                ; 269  [unreachable]
            OUTPUT   s4, E7                ; 26A  [unreachable]
            STORE    s5, 38                ; 26B  [unreachable]
            STORE    s6, 37                ; 26C  [unreachable]
            LOAD     s4, 00                ; 26D  [unreachable]
            OUTPUT   s4, E6                ; 26E  [unreachable]
            LOAD     s0, 00                ; 26F  [unreachable]
            LOAD     s1, 00                ; 270  [unreachable]
            LOAD     s2, 00                ; 271  [unreachable]
old_copy_c_L0F:
            FETCH    s4, 37                ; 272  [unreachable]
            FETCH    s5, 38                ; 273  [unreachable]
            ADD      s4, s0                ; 274  [unreachable]
            ADDCY    s5, s1                ; 275  [unreachable]
            OUTPUT   s5, E5                ; 276  [unreachable]
            OUTPUT   s4, E4                ; 277  [unreachable]
            LOAD     s4, 05                ; 278  [unreachable]
            OUTPUT   s4, E7                ; 279  [unreachable]
            LOAD     s4, 01                ; 27A  [unreachable]
            OUTPUT   s4, E7                ; 27B  [unreachable]
            ADD      s0, 01                ; 27C  [unreachable]
            ADDCY    s1, 00                ; 27D  [unreachable]
            ADDCY    s2, 00                ; 27E  [unreachable]
            COMPARE  s6, EF                ; 27F  [unreachable]
            JUMP     Z, old_copy_c_L21     ; 280  [unreachable]
            COMPARE  s1, 08                ; 281  [unreachable]
            JUMP     Z, old_copy_c_L24     ; 282  [unreachable]
            JUMP     old_copy_c_L0F        ; 283  [unreachable]
old_copy_c_L21:
            COMPARE  s2, 01                ; 284  [unreachable]
            JUMP     Z, old_copy_c_L24     ; 285  [unreachable]
            JUMP     old_copy_c_L0F        ; 286  [unreachable]
old_copy_c_L24:
            LOAD     s4, 00                ; 287  [unreachable]
            OUTPUT   s4, E7                ; 288  [unreachable]
            RETURN                         ; 289  [unreachable]

; ------------------------------------------------------------------------------
; table_page / table_read: read 32-bit word s5 (+ page offset from scratch 3B)
; of the load table into s3:s2:s1:s0 (s0 = LSB) via port BF and C0-C3.
; ------------------------------------------------------------------------------
table_page:
            LOAD     s5, s6                ; 28A
            FETCH    s4, 3B                ; 28B  page select
            COMPARE  s4, 00                ; 28C
            JUMP     Z, table_page_L09     ; 28D
            COMPARE  s4, FF                ; 28E
            JUMP     Z, table_page_L08     ; 28F
            ADD      s5, C0                ; 290  page C0
            RETURN                         ; 291
table_page_L08:
            ADD      s5, 80                ; 292  page 80
table_page_L09:
            RETURN                         ; 293
table_read:
            OUTPUT   s5, BF                ; 294  word index
            LOAD     s1, s1                ; 295
            LOAD     s1, s1                ; 296
            LOAD     s1, s1                ; 297
            INPUT    s3, C0                ; 298  b31:24
            INPUT    s2, C1                ; 299
            INPUT    s1, C2                ; 29A
            INPUT    s0, C3                ; 29B  b7:0
            LOAD     s4, s0                ; 29C  debug: every table word read (4 bytes)
            LOAD     sF, s3                ; 29D
            CALL     dbg_putc              ; 29E
            LOAD     sF, s2                ; 29F
            CALL     dbg_putc              ; 2A0
            LOAD     sF, s1                ; 2A1
            CALL     dbg_putc              ; 2A2
            LOAD     sF, s4                ; 2A3
            CALL     dbg_putc              ; 2A4
            LOAD     s0, s4                ; 2A5
            RETURN                         ; 2A6

; ------------------------------------------------------------------------------
; map_sector: translate a file sector offset (s7-sA) into an LBA using the
; {offset, LBA} pairs: find the last pair whose offset <= file sector, then
; LBA = pair.LBA + (file sector - pair.offset). Converts to a byte address for
; standard-capacity cards (lba_to_addr).
; ------------------------------------------------------------------------------
map_sector:
            LOAD     s6, 02                ; 2A7  pair index 2, 4, 6, ...
map_sector_L01:
            CALL     table_page            ; 2A8
            CALL     table_read            ; 2A9
            LOAD     s4, s7                ; 2AA  compare file sector with pair offset
            SUB      s4, s0                ; 2AB
            LOAD     s4, s8                ; 2AC
            SUBCY    s4, s1                ; 2AD
            LOAD     s4, s9                ; 2AE
            SUBCY    s4, s2                ; 2AF
            LOAD     s4, sA                ; 2B0
            SUBCY    s4, s3                ; 2B1
            JUMP     C, map_sector_L10     ; 2B2  file sector < offset: use previous pair
            COMPARE  s6, 7C                ; 2B3  end of table
            JUMP     Z, map_sector_L12     ; 2B4
            ADD      s6, 02                ; 2B5
            JUMP     map_sector_L01        ; 2B6
map_sector_L10:
            SUB      s6, 02                ; 2B7
            JUMP     map_sector_L13        ; 2B8
map_sector_L12:
            LOAD     s6, 00                ; 2B9  end of table reached: fall back to pair 0
map_sector_L13:
            CALL     table_page            ; 2BA
            CALL     table_read            ; 2BB
            SUB      s7, s0                ; 2BC  file sector - offset
            SUBCY    s8, s1                ; 2BD
            SUBCY    s9, s2                ; 2BE
            SUBCY    sA, s3                ; 2BF
            ADD      s6, 01                ; 2C0
            CALL     table_page            ; 2C1
            CALL     table_read            ; 2C2
            ADD      s7, s0                ; 2C3  + LBA
            ADDCY    s8, s1                ; 2C4
            ADDCY    s9, s2                ; 2C5
            ADDCY    sA, s3                ; 2C6
            CALL     lba_to_addr           ; 2C7
            RETURN                         ; 2C8

; lba_to_addr: for SDSC cards (scratch 06 != 1) multiply s7-sA by 512.
lba_to_addr:
            FETCH    s4, 06                ; 2C9
            COMPARE  s4, 01                ; 2CA  high capacity: block address as is
            JUMP     Z, lba_to_addr_L0A    ; 2CB
            LOAD     sA, s9                ; 2CC  SDSC: byte address = sector * 512
            LOAD     s9, s8                ; 2CD
            LOAD     s8, s7                ; 2CE
            SL0      s8                    ; 2CF
            SLA      s9                    ; 2D0
            SLA      sA                    ; 2D1
            LOAD     s7, 00                ; 2D2
lba_to_addr_L0A:
            RETURN                         ; 2D3

; get_gb_sector: s7-sA = sector number from $7FB0-$7FB3 (converted for SDSC),
; scratch 20 = ($7FB4 count) - 1. (Bit 7 of $7FB4, the write flag, is presumably
; removed by the hardware, which reports it as event 40 instead.)
get_gb_sector:
            INPUT    sA, B3                ; 2D4  $7FB3
            INPUT    s9, B2                ; 2D5
            INPUT    s8, B1                ; 2D6
            INPUT    s7, B0                ; 2D7  $7FB0
            CALL     lba_to_addr           ; 2D8
            INPUT    s1, B4                ; 2D9  $7FB4
            LOAD     sF, s1                ; 2DA  debug: sector count
            CALL     dbg_putc              ; 2DB
            SUB      s1, 01                ; 2DC
            STORE    s1, 20                ; 2DD  block count - 1
            RETURN                         ; 2DE

; Unreachable: pulse port E9.
old_pulse_e9:
            LOAD     s0, 00                ; 2DF  [unreachable]
            OUTPUT   s0, E9                ; 2E0  [unreachable]
            LOAD     s0, 01                ; 2E1  [unreachable]
            OUTPUT   s0, E9                ; 2E2  [unreachable]
            CALL     delay_tiny            ; 2E3  [unreachable]
            LOAD     s0, 00                ; 2E4  [unreachable]
            OUTPUT   s0, E9                ; 2E5  [unreachable]
            LOAD     s0, 00                ; 2E6  [unreachable]
            RETURN                         ; 2E7  [unreachable]

; ------------------------------------------------------------------------------
; BIT-BANGED I2C on port EC (b0 SCL, b1 SDA, sF = shadow) / EB (inputs).
; SCL high waits for the line to actually rise (clock stretching).
; i2c_write_byte: s5 MSB first.  i2c_read_byte: 8 bits into s5.
; i2c_get_ack: clock in the ACK bit; returns carry = 1 on NACK.
; ------------------------------------------------------------------------------
i2c_idle:
            LOAD     sF, 01                ; 2E8  SCL and SDA released
            OR       sF, 02                ; 2E9
            OUTPUT   sF, EC                ; 2EA
            RETURN                         ; 2EB
i2c_start:
            CALL     i2c_sda_high          ; 2EC
            CALL     i2c_scl_high          ; 2ED
            CALL     i2c_delay5            ; 2EE
            CALL     i2c_sda_low           ; 2EF  SDA low while SCL high = START
            CALL     i2c_delay4            ; 2F0
            CALL     i2c_scl_low           ; 2F1
            RETURN                         ; 2F2
i2c_stop:
            CALL     i2c_sda_low           ; 2F3
            CALL     i2c_delay5            ; 2F4
            CALL     i2c_scl_high          ; 2F5
            CALL     i2c_delay4            ; 2F6
            CALL     i2c_sda_high          ; 2F7  SDA high while SCL high = STOP
            RETURN                         ; 2F8
i2c_write_byte:
            LOAD     s1, 80                ; 2F9  bit mask
i2c_write_byte_L01:
            TEST     s5, s1                ; 2FA
            JUMP     NZ, i2c_write_byte_L05 ; 2FB
            CALL     i2c_sda_low           ; 2FC  bit = 0
            JUMP     i2c_write_byte_L06    ; 2FD
i2c_write_byte_L05:
            CALL     i2c_sda_high          ; 2FE  bit = 1
i2c_write_byte_L06:
            CALL     i2c_clock             ; 2FF
            SR0      s1                    ; 300  next bit; carry out after bit 0
            RETURN C                       ; 301
            JUMP     i2c_write_byte_L01    ; 302
i2c_read_byte:
            LOAD     s1, 08                ; 303  8 bits
i2c_read_byte_L01:
            CALL     i2c_read_bit          ; 304
            SUB      s1, 01                ; 305
            JUMP     NZ, i2c_read_byte_L01 ; 306
            RETURN                         ; 307
i2c_ack:
            CALL     i2c_sda_low           ; 308  ACK = SDA low
i2c_clock:
            CALL     i2c_delay5            ; 309
            CALL     i2c_scl_high          ; 30A
            CALL     i2c_delay4            ; 30B
            CALL     i2c_scl_low           ; 30C
            RETURN                         ; 30D
i2c_nack:
            CALL     i2c_sda_high          ; 30E  NACK = SDA high
            JUMP     i2c_clock             ; 30F
i2c_get_ack:
            CALL     i2c_read_bit          ; 310
            TEST     s5, 01                ; 311  carry = ACK bit (1 = NACK)
            RETURN                         ; 312
i2c_scl_low:
            AND      sF, 02                ; 313  SCL low
            OUTPUT   sF, EC                ; 314
            CALL     i2c_delay5            ; 315
            RETURN                         ; 316
i2c_scl_high:
            OR       sF, 01                ; 317  release SCL
            OUTPUT   sF, EC                ; 318
i2c_scl_high_L02:
            INPUT    s0, EB                ; 319  wait until SCL is high (stretching)
            TEST     s0, 01                ; 31A
            JUMP     Z, i2c_scl_high_L02   ; 31B
            RETURN                         ; 31C
i2c_sda_low:
            AND      sF, 01                ; 31D  SDA low
            OUTPUT   sF, EC                ; 31E
            RETURN                         ; 31F
i2c_sda_high:
            OR       sF, 02                ; 320  release SDA
            OUTPUT   sF, EC                ; 321
            RETURN                         ; 322
i2c_read_bit:
            CALL     i2c_sda_high          ; 323
            CALL     i2c_delay5            ; 324
            CALL     i2c_scl_high          ; 325
            CALL     i2c_delay2            ; 326
            INPUT    s0, EB                ; 327  sample SDA
            TEST     s0, 02                ; 328
            SLA      s5                    ; 329  shift into s5
            CALL     i2c_delay2            ; 32A
            CALL     i2c_scl_low           ; 32B
            RETURN                         ; 32C
i2c_delay5:
            CALL     i2c_delay1            ; 32D
i2c_delay4:
            CALL     i2c_delay1            ; 32E
            CALL     i2c_delay1            ; 32F
i2c_delay2:
            CALL     i2c_delay1            ; 330
            CALL     i2c_delay1            ; 331
            RETURN                         ; 332
i2c_delay1:
            LOAD     s0, 01                ; 333
i2c_delay1_L01:
            SUB      s0, 01                ; 334
            JUMP     NZ, i2c_delay1_L01    ; 335
            RETURN                         ; 336

; ------------------------------------------------------------------------------
; PCF8563 RTC ACCESS (I2C address 51: A2 write, A3 read)
; rtc_write0: register sB = 00.  rtc_write: register sB = sD.
; rtc_select_read: START, A2, register sB, repeated START, A3.
; rtc_read: sD = register sB.
; ------------------------------------------------------------------------------
rtc_write0:
            LOAD     sD, 00                ; 337  value 00
rtc_write:
            CALL     i2c_idle              ; 338
            CALL     i2c_start             ; 339
            LOAD     s5, 51                ; 33A  device address 51 << 1 = A2 (write)
            SL0      s5                    ; 33B
            CALL     i2c_write_byte        ; 33C
            CALL     i2c_get_ack           ; 33D
            RETURN C                       ; 33E  abort on NACK
            LOAD     s5, sB                ; 33F  register number
            CALL     i2c_write_byte        ; 340
            CALL     i2c_get_ack           ; 341
            RETURN C                       ; 342
            LOAD     s5, sD                ; 343  value
            CALL     i2c_write_byte        ; 344
            CALL     i2c_get_ack           ; 345
            RETURN C                       ; 346
            CALL     i2c_stop              ; 347  STOP
            RETURN                         ; 348
rtc_select_read:
            CALL     i2c_idle              ; 349
            CALL     i2c_start             ; 34A
            LOAD     s5, 51                ; 34B
            SL0      s5                    ; 34C
            CALL     i2c_write_byte        ; 34D
            CALL     i2c_get_ack           ; 34E
            RETURN C                       ; 34F
            LOAD     s5, sB                ; 350
            CALL     i2c_write_byte        ; 351
            CALL     i2c_get_ack           ; 352
            RETURN C                       ; 353
            CALL     i2c_start             ; 354
            LOAD     s5, 51                ; 355
            SL1      s5                    ; 356  A3 (read)
            CALL     i2c_write_byte        ; 357
            CALL     i2c_get_ack           ; 358
            RETURN C                       ; 359
            RETURN                         ; 35A
rtc_read:
            CALL     rtc_select_read       ; 35B
            CALL     i2c_read_byte         ; 35C
            LOAD     sD, s5                ; 35D
rtc_read_L03:
            CALL     i2c_nack              ; 35E
            CALL     i2c_stop              ; 35F
            RETURN                         ; 360

; rtc_publish: burst-read PCF8563 registers 2-8 (seconds .. years) and write
; each into the Game Boy RTC window: ED = register number, EE = value
; (the window shows them at $Ax08-$Ax0E).
rtc_publish:
            CALL     rtc_select_read       ; 361
rtc_publish_L01:
            CALL     i2c_read_byte         ; 362
            OUTPUT   sB, ED                ; 363  window index
            OUTPUT   s5, EE                ; 364  window data
            COMPARE  sB, 08                ; 365  last register (years)?
            JUMP     Z, rtc_read_L03       ; 366
            ADD      sB, 01                ; 367
            CALL     i2c_ack               ; 368  ACK, read next
            JUMP     rtc_publish_L01       ; 369

; rtc_set_from_gb (event 10, $7FD0 = 01): for registers 2-8, select the byte
; via F0, read what the Game Boy wrote (B6) and store it in the PCF8563.
rtc_set_from_gb:
            LOAD     sB, 02                ; 36A  first register: seconds
rtc_set_from_gb_L01:
            OUTPUT   sB, F0                ; 36B  select byte sB of the GB data
            LOAD     s0, s0                ; 36C
            INPUT    sD, B6                ; 36D  byte the GB wrote
            CALL     rtc_write             ; 36E  store in RTC
            COMPARE  sB, 08                ; 36F
            RETURN Z                       ; 370
            ADD      sB, 01                ; 371
            JUMP     rtc_set_from_gb_L01   ; 372

; rtc_init: control 1 = 20 (stop), CLKOUT = 80 (enabled), control 1 = 00. If the
; VL (clock integrity) flag in the seconds register is set, reset the clock to
; year 00, month 01, weekday 03, day 01, 00:00:00 and restart it.
rtc_init:
            LOAD     sB, 00                ; 373  control 1 = 20: STOP
            LOAD     sD, 20                ; 374
            CALL     rtc_write             ; 375
            LOAD     sB, 0D                ; 376  CLKOUT control = 80: enabled
            LOAD     sD, 80                ; 377
            CALL     rtc_write             ; 378
            LOAD     sB, 00                ; 379  control 1 = 00: run
            CALL     rtc_write0            ; 37A
            LOAD     sB, 02                ; 37B  seconds register
            CALL     rtc_read              ; 37C
            AND      sD, 80                ; 37D  VL flag: clock integrity lost?
            COMPARE  sD, 80                ; 37E
            RETURN NZ                      ; 37F
            LOAD     sB, 00                ; 380  stop clock
            LOAD     sD, 20                ; 381
            CALL     rtc_write             ; 382
            LOAD     sB, 08                ; 383  years = 00
            CALL     rtc_write0            ; 384
            LOAD     sB, 07                ; 385  months = 01
            LOAD     sD, 01                ; 386
            CALL     rtc_write             ; 387
            LOAD     sB, 06                ; 388  weekdays = 03
            LOAD     sD, 03                ; 389
            CALL     rtc_write             ; 38A
            LOAD     sB, 05                ; 38B  days = 01
            LOAD     sD, 01                ; 38C
            CALL     rtc_write             ; 38D
            LOAD     sB, 04                ; 38E  hours = 00
            CALL     rtc_write0            ; 38F
            LOAD     sB, 03                ; 390  minutes = 00
            CALL     rtc_write0            ; 391
            LOAD     sB, 02                ; 392  seconds = 00 (clears VL)
            CALL     rtc_write0            ; 393
            LOAD     sB, 01                ; 394  control 2 = 00
            CALL     rtc_write0            ; 395
            LOAD     sB, 00                ; 396  control 1 = 00: run
            CALL     rtc_write0            ; 397
            RETURN                         ; 398

; ------------------------------------------------------------------------------
; sd_wait_tran: CMD13 until the card status (bits 15:8) is 09 = state "tran"
; and ready-for-data; otherwise send CMD12 and retry.
; ------------------------------------------------------------------------------
sd_wait_tran:
            CALL     sd_cmd13              ; 399  CMD13 SEND_STATUS
            CALL     sd_get_resp           ; 39A
            FETCH    s0, 04                ; 39B  status bits 15:8
            COMPARE  s0, 09                ; 39C  09 = tran, ready for data
            JUMP     NZ, sd_wait_tran_L06  ; 39D
            RETURN                         ; 39E
sd_wait_tran_L06:
            CALL     sd_cmd12              ; 39F  not ready: CMD12 and retry
            JUMP     sd_wait_tran          ; 3A0

; ------------------------------------------------------------------------------
; ISR entry (FW0-FW3): debug DD, then the event byte, then dispatch on B5
; (see isr_events). The sector-read path also prints 44 when done.
; ------------------------------------------------------------------------------
isr:
            LOAD     sF, DD                ; 3A1  debug DD
            CALL     dbg_putc              ; 3A2

; isr_events: dispatch on B5.
isr_events:
            INPUT    s3, B5                ; 3A3  event flags
            LOAD     sF, s3                ; 3A4  debug: event byte
            CALL     dbg_putc              ; 3A5
            COMPARE  s3, 80                ; 3A6  read sectors
            JUMP     NZ, isr_L08           ; 3A7
            CALL     sd_wait_tran          ; 3A8  card ready
            CALL     get_gb_sector         ; 3A9  LBA and count from $7FB0-$7FB4
            CALL     sd_read_multi         ; 3AA  CMD18 into the sector buffer
            CALL     sd_cmd12              ; 3AB  CMD12
            LOAD     sF, 44                ; 3AC  debug 44: read done
            CALL     dbg_putc              ; 3AD
            JUMP     isr_exit              ; 3AE
isr_L08:
            COMPARE  s3, 40                ; 3AF  write sectors
            JUMP     NZ, isr_L0F           ; 3B0
            CALL     sd_wait_tran          ; 3B1
            CALL     get_gb_sector         ; 3B2
            CALL     sd_write_multi        ; 3B3  CMD25 from the sector buffer
            CALL     sd_cmd12              ; 3B4
            JUMP     isr_exit              ; 3B5
isr_L0F:
            COMPARE  s3, 20                ; 3B6  ROM load
            JUMP     NZ, isr_L13           ; 3B7
            CALL     rom_load              ; 3B8
            JUMP     isr_exit              ; 3B9
isr_L13:
            COMPARE  s3, 10                ; 3BA  set RTC
            JUMP     NZ, isr_L17           ; 3BB
            CALL     rtc_set_from_gb       ; 3BC
            JUMP     isr_exit              ; 3BD
isr_L17:
            COMPARE  s3, 08                ; 3BE  flash page write
            JUMP     NZ, isr_exit          ; 3BF
            LOAD     s2, 01                ; 3C0  scratch 3F = 1: bank 1 takes the update path
            STORE    s2, 3F                ; 3C1
            CALL     bank_call             ; 3C2  -> bank 1
            JUMP     isr_exit              ; 3C3
isr_exit:
            RETURNI  ENABLE                ; 3C4

            ADDRESS 3F0

; ------------------------------------------------------------------------------
; bank_call: switch to program bank 1 and back. Bank 1 has the same eight
; instructions here, except that its 3F3 is "CALL 1B5" (bank-1 dispatcher).
; Writing 1 to C8 switches banks; the NOPs (LOAD s0, s0) cover the fetch
; pipeline, so execution continues at 3F3 in bank 1, calls the bank-1 code, and
; returns to 3F4, where C8 = 0 switches back. In this bank 3F3 is only a NOP.
; ------------------------------------------------------------------------------
bank_call:
            LOAD     s0, 01                ; 3F0
            OUTPUT   s0, C8                ; 3F1  select bank 1
            LOAD     s0, s0                ; 3F2  NOP (pipeline)
            LOAD     s0, s0                ; 3F3  NOP here; CALL 1B5 in bank 1
            LOAD     s0, 00                ; 3F4
            OUTPUT   s0, C8                ; 3F5  select bank 0
            LOAD     s0, s0                ; 3F6  NOP (pipeline)
            RETURN                         ; 3F7
            LOAD     s0, 00                ; 3F8  [unreachable]
            LOAD     s0, 00                ; 3F9  [unreachable]
            LOAD     s0, 00                ; 3FA  [unreachable]
            LOAD     s0, 00                ; 3FB  [unreachable]
            LOAD     s0, 00                ; 3FC  [unreachable]
            LOAD     s0, 00                ; 3FD  [unreachable]
            LOAD     s0, 00                ; 3FE  [unreachable]

; Interrupt vector.
            JUMP     isr                   ; 3FF
