;==============================================================================
; EZ-Flash Junior FPGA (XC3S200A) - PicoBlaze KCPSM3, program BANK 0
; FW5 slot B: the second bitstream in both FW5 update ROMs (identical in
; both, never written to flash by the updater). Code base: FW4 plus a
; debug heartbeat and the port-BB loader option of FW5.
; Extra ports: AB, AC, AE, AF, A8, A9 in (heartbeat dump), BB in (loader
; option). Scratch 2B = sampled BB.
;
; Commented disassembly. Re-assembles to the original 1024 words (pbasm.py).
; Labels, comments and section headers are shared with the FW4 listing and
; were carried over by instruction alignment; code that only exists in this
; version is annotated separately.
;------------------------------------------------------------------------------
; ARCHITECTURE
;   One KCPSM3 core runs from two 1K-word program BRAMs (bank 0 = this file,
;   bank 1 = the updater/licence code). Output port C8 selects the bank; the
;   switch happens inside the routine at 3F0, which exists at the same address
;   in both banks (see bank_call). Registers and the 64-byte scratchpad are
;   shared, which is how bank 1 hands results back (scratchpad 3E/3F).
;
;   The core resets into bank 0. Bank 1 is entered twice:
;     - at boot (3F = 0): licence check against the Device DNA; on success
;       bank 1 leaves 3E=F1, 3F=F2, which unlocks ROM loading here.
;     - on event 08 (3F = 1): program one 256-byte page of the SPI config flash
;       (firmware update).
;
; FUNCTIONS IN THIS BANK
;   - SD card bring-up and sector transfers through an SD host controller with
;     DMA, reached over a Wishbone-style bridge (ports 70-73 + indexed port).
;     Register layout and command-word format are consistent with the
;     OpenCores sd_card_controller (Marek Czerski).
;   - ROM loading from the SD card (cluster by cluster, from the 512-byte
;     load table written by the Game Boy at $7F36=1).
;   - PCF8563 real-time clock over bit-banged I2C: init, continuous readout
;     into the Game Boy RTC window, and setting the time.
;
; SD CONTROLLER REGISTERS (Wishbone address = port number used with (sE))
;   00 argument          04 command (index<<8 | flags)   08-14 response
;   18 data timeout?     1C bus width (1 = 4-bit)        20 cmd timeout?
;   24 clock divider     28 software reset               34 cmd event status
;   38 cmd event enable  3C data event status            40 data event enable
;   44 block size - 1    48 block count - 1              60 DMA address
;   Command flags (low byte): b1:0 response (01 = 48-bit, 10 = 136-bit),
;   b2 busy check, b3 CRC check, b4 index check, b5 read data, b6 write data.
;   Routine sd_cmd takes "sB" flags: b0 response, b1 long, b2 CRC check,
;   b3 busy, b4 index check (15 = R1, 1D = R1b, 07 = R2, 01 = R3).
;
; INPUT PORTS                               OUTPUT PORTS
;   00-7F (sE) Wishbone ack, b1:0 != 0        00-7F (sE) Wishbone write strobe
;   70-73  Wishbone read data (70 = LSB)      70-73  Wishbone write data (70 = LSB)
;   A0     debug TX status, b2 = busy         A1     debug byte out
;   B0-B3  sector number ($7FB0-$7FB3)        BF     load-table word index
;   B4     sector count ($7FB4)               C8     program bank select (1 = bank 1)
;   B5     event flags (see isr)              E0-E3  ROM-load destination (file sector)
;   B6     RTC byte written by the GB         EC     I2C out: b0 SCL, b1 SDA (1 = release)
;   B9     01 while the RTC window is mapped  ED/EE  RTC window index / data
;   C0-C3  load-table word (C0 = b31:24)      EF     ROM load busy (1 = loading)
;   EB     I2C in: b0 SCL, b1 SDA             F0     index of RTC byte to fetch on B6
;   (A2, A3, B7, E4-E7, E9, F2 are only used by unreachable code)
;
; SCRATCHPAD
;   00 ACMD41 retry counter        01 02 = SD v2 card (CMD8 echo ok)
;   02-05 last response (02 = b31:24 .. 05 = b7:0)
;   06 01 = high-capacity card (block addressing)
;   13-16 CID response (first word)    17-18 RCA
;   19 data phase of next command: 01 read, 02 write
;   1A-1D DMA address (1A = MSB)       1E-1F block size - 1 (01FF)
;   20 block count - 1                 2A/31 sectors per cluster (lo/hi)
;   2C-2F current file sector during ROM load (2F = LSB)
;   3B load-table page (00 = words 00-7F)   3D last data event status
;   3E/3F licence flags (F1/F2 = licensed, written by bank 1)
;   3F also: 01 = "flash page write requested" when entering bank 1
;==============================================================================


            ADDRESS 000

; ------------------------------------------------------------------------------
; RESET: run the bank-1 boot code (licence check), print the licence flags,
; bring up the SD card (CMD0, CMD8, ACMD41, CMD2, CMD3, CMD7, CMD16, ACMD6 4-bit),
; initialise the RTC, then enter the main loop with interrupts enabled.
; ------------------------------------------------------------------------------
reset:
            DISABLE INTERRUPT              ; 000
            LOAD     s2, 00                ; 001  scratch 3F = 0: bank 1 runs its boot path
            STORE    s2, 3F                ; 002
            CALL     bank_call             ; 003  -> bank 1 (licence check, sets 3E/3F)
            FETCH    sF, 3E                ; 004  debug: licence flags (F1, F2 when ok)
            CALL     dbg_putc              ; 005
            FETCH    sF, 3F                ; 006
            CALL     dbg_putc              ; 007
            CALL     clear_scratch         ; 008
            CALL     sdc_init_regs         ; 009  SD controller setup, slow clock
            CALL     delay_m               ; 00A
            CALL     sd_cmd0               ; 00B  CMD0
            LOAD     sF, B0                ; 00C  debug B0
            CALL     dbg_putc              ; 00D
            CALL     delay_s               ; 00E
            CALL     sd_cmd8               ; 00F  CMD8 (SEND_IF_COND 1AA)
            CALL     sd_get_resp           ; 010
            FETCH    s0, 05                ; 011  echoed check pattern
            FETCH    s0, 05                ; 012
            COMPARE  s0, AA                ; 013  AA = card understood CMD8
            JUMP     NZ, init_acmd41       ; 014
            LOAD     s0, 02                ; 015  scratch 01 = 2: SD version 2 card
            STORE    s0, 01                ; 016
            JUMP     init_acmd41           ; 017
init_acmd41:
            CALL     sd_wait_ready         ; 018  CMD55/ACMD41 until ready
            CALL     sd_cmd2               ; 019  CMD2 (ALL_SEND_CID)
            CALL     sd_save_cid           ; 01A  keep CID word
            CALL     delay_s               ; 01B
            CALL     sd_cmd3               ; 01C  CMD3 (SEND_RELATIVE_ADDR)
            CALL     delay_m               ; 01D
            CALL     sd_get_resp           ; 01E
            FETCH    s0, 02                ; 01F  RCA = response bits 31:16
            STORE    s0, 17                ; 020
            FETCH    s0, 03                ; 021
            STORE    s0, 18                ; 022
            LOAD     s0, 00                ; 023  clock divider 0: full speed
            CALL     sdc_set_clkdiv        ; 024
            CALL     sdc_reset_off         ; 025  software reset register = 0
            CALL     sd_cmd7               ; 026  CMD7 (SELECT_CARD)
            LOAD     s1, 02                ; 027
            LOAD     s0, 00                ; 028
            CALL     sd_cmd16              ; 029  CMD16 SET_BLOCKLEN 512
            CALL     sd_cmd55              ; 02A  CMD55
            CALL     sd_acmd6              ; 02B  ACMD6: 4-bit bus
            CALL     sdc_bus4              ; 02C  controller: 4-bit bus
            CALL     sd_cmd13              ; 02D  CMD13
            CALL     rtc_init              ; 02E  PCF8563 init
            LOAD     sF, EE                ; 02F  debug EE: init done
            CALL     dbg_putc              ; 030
            ENABLE INTERRUPT               ; 031

; ------------------------------------------------------------------------------
; MAIN LOOP: while the Game Boy has the RTC window mapped (B9 = 01), keep copying
; the PCF8563 time into it. All Game Boy commands arrive as interrupts (isr).
; ------------------------------------------------------------------------------
main_loop:
            INPUT    s1, B9                ; 032  RTC window mapped?
            COMPARE  s1, 01                ; 033
            JUMP     NZ, main_idle         ; 034
            LOAD     sB, 02                ; 035  start at register 2 (seconds)
            DISABLE INTERRUPT              ; 036  no interrupts during the I2C burst
            CALL     rtc_publish           ; 037
            ENABLE INTERRUPT               ; 038
main_idle:
            CALL     delay_l               ; 039  pause, then poll again

; ------------------------------------------------------------------------------
; Debug heartbeat (FW5 slot B only): after every main-loop pause, send EE and
; then input ports AC, AB, AF, AE, A9, A8 to the debug output.
; ------------------------------------------------------------------------------
debug_heartbeat:
            LOAD     sF, EE                ; 03A  heartbeat marker EE
            CALL     dbg_putc              ; 03B
            INPUT    s5, AC                ; 03C  port AC
            LOAD     sF, s5                ; 03D
            CALL     dbg_putc              ; 03E
            INPUT    s5, AB                ; 03F  port AB
            LOAD     sF, s5                ; 040
            CALL     dbg_putc              ; 041
            INPUT    s5, AF                ; 042  port AF
            LOAD     sF, s5                ; 043
            CALL     dbg_putc              ; 044
            INPUT    s5, AE                ; 045  port AE
            LOAD     sF, s5                ; 046
            CALL     dbg_putc              ; 047
            INPUT    s5, A9                ; 048  port A9
            LOAD     sF, s5                ; 049
            CALL     dbg_putc              ; 04A
            INPUT    s5, A8                ; 04B  port A8
            LOAD     sF, s5                ; 04C
            CALL     dbg_putc              ; 04D
            JUMP     main_loop             ; 04E

; Unreachable: pulse output port F2.
            CALL     delay_s               ; 04F  [unreachable]
            LOAD     s1, 00                ; 050  [unreachable]
            OUTPUT   s1, F2                ; 051  [unreachable]
            LOAD     s2, 01                ; 052  [unreachable]
            OUTPUT   s2, F2                ; 053  [unreachable]
            OUTPUT   s1, F2                ; 054  [unreachable]
            RETURN                         ; 055  [unreachable]

; clear_scratch: zero scratchpad 00-3D (3E/3F, the licence flags, survive).
clear_scratch:
            LOAD     s6, 00                ; 056
            LOAD     s4, 00                ; 057
clear_scratch_L02:
            COMPARE  s4, 3E                ; 058
            JUMP     C, clear_scratch_L05  ; 059
            JUMP     clear_scratch_L08     ; 05A
clear_scratch_L05:
            STORE    s6, (s4)              ; 05B
            ADD      s4, 01                ; 05C
            JUMP     clear_scratch_L02     ; 05D
clear_scratch_L08:
            RETURN                         ; 05E

; ------------------------------------------------------------------------------
; SD COMMAND WRAPPERS. Each loads sC = command index, sB = response flags,
; s7-sA = argument (s7 = LSB) and falls into sd_cmd.
; ------------------------------------------------------------------------------
; sd_cmd0: GO_IDLE_STATE, no response.
sd_cmd0:
            LOAD     sC, 00                ; 05F
            LOAD     sB, 00                ; 060
            JUMP     sd_cmd_noarg          ; 061

; sd_cmd8: SEND_IF_COND, argument 000001AA (2.7-3.6 V, check pattern AA), R7.
sd_cmd8:
            LOAD     sC, 08                ; 062
            LOAD     sB, 15                ; 063
            LOAD     s8, 01                ; 064  argument 000001AA
            LOAD     s7, AA                ; 065
            JUMP     sd_cmd_arg16          ; 066

; sd_wait_ready: repeat CMD55 + ACMD41 until the card reports power-up done
; (OCR bit 31), at most 255 tries. Sets scratch 06 = 01 for a high-capacity card
; (OCR bit 30, CCS); debug byte 82 = SDHC/SDXC, 88 = SDSC or timeout.
sd_wait_ready:
            LOAD     s3, FF                ; 067  up to 255 attempts
            STORE    s3, 00                ; 068
            LOAD     s0, 00                ; 069
            STORE    s0, 17                ; 06A
            STORE    s0, 18                ; 06B
acmd41_retry:
            CALL     sd_cmd55              ; 06C
            CALL     delay_s               ; 06D
            CALL     sd_acmd41             ; 06E
            CALL     delay_s               ; 06F
            CALL     sd_get_resp           ; 070
            FETCH    s0, 02                ; 071  OCR bits 31:24
            TEST     s0, 80                ; 072  bit 31: power-up done
            JUMP     NZ, acmd41_ready      ; 073
            FETCH    s3, 00                ; 074  not ready: count down
            SUB      s3, 01                ; 075
            STORE    s3, 00                ; 076
            COMPARE  s3, 00                ; 077
            JUMP     Z, acmd41_sdsc        ; 078  gave up
            CALL     delay_l               ; 079
            JUMP     acmd41_retry          ; 07A
acmd41_ready:
            FETCH    s0, 01                ; 07B
            COMPARE  s0, 02                ; 07C
            JUMP     Z, acmd41_ready_L05   ; 07D
            LOAD     s0, 01                ; 07E  not v2: scratch 01 = 1
            STORE    s0, 01                ; 07F
acmd41_ready_L05:
            FETCH    s0, 02                ; 080
            TEST     s0, 40                ; 081  bit 30: CCS (high capacity)
            JUMP     Z, acmd41_sdsc        ; 082
            LOAD     s3, 01                ; 083  high capacity
            LOAD     sF, 82                ; 084  debug 82
            CALL     dbg_putc              ; 085
            JUMP     acmd41_done           ; 086
acmd41_sdsc:
            LOAD     sF, 88                ; 087  debug 88
            CALL     dbg_putc              ; 088
            LOAD     s3, 00                ; 089  standard capacity
acmd41_done:
            STORE    s3, 06                ; 08A  scratch 06 = capacity flag
            RETURN                         ; 08B

; sd_cmd55: APP_CMD with the card's RCA (R1).
sd_cmd55:
            LOAD     sC, 37                ; 08C  CMD55
sd_cmd_rca:
            LOAD     sB, 15                ; 08D
            FETCH    sA, 17                ; 08E  argument = RCA << 16
            FETCH    s9, 18                ; 08F
            JUMP     sd_cmd_arg_hi         ; 090

; sd_cmd13: SEND_STATUS with RCA (R1).
sd_cmd13:
            LOAD     sC, 0D                ; 091  CMD13
            JUMP     sd_cmd_rca            ; 092

; sd_acmd41: SD_SEND_OP_COND, argument 40300000 (HCS + 3.2-3.4 V), R3.
; The OR at 085 is overwritten by the LOAD at 086, so HCS is always set.
sd_acmd41:
            LOAD     sC, 29                ; 093  ACMD41 (index 29)
            LOAD     sB, 01                ; 094  R3: response, no CRC check
            LOAD     sA, 00                ; 095
            FETCH    s0, 01                ; 096
            COMPARE  s0, 02                ; 097
            JUMP     NZ, sd_acmd41_L07     ; 098
            OR       sA, 40                ; 099  (dead: overwritten below)
sd_acmd41_L07:
            LOAD     sA, 40                ; 09A  argument 4030_0000
            LOAD     s9, 30                ; 09B
sd_cmd_arg_hi:
            LOAD     s8, 00                ; 09C
            LOAD     s7, 00                ; 09D
            CALL     sd_cmd                ; 09E
            RETURN                         ; 09F

; sd_cmd2: ALL_SEND_CID, R2 (136-bit).
sd_cmd2:
            LOAD     sC, 02                ; 0A0  CMD2
            LOAD     sB, 07                ; 0A1  R2 (136-bit, CRC)
            JUMP     sd_cmd_noarg          ; 0A2

; sd_cmd3: SEND_RELATIVE_ADDR, R6.
sd_cmd3:
            LOAD     sC, 03                ; 0A3  CMD3
            LOAD     sB, 15                ; 0A4
            JUMP     sd_cmd_noarg          ; 0A5

; sd_cmd7: SELECT_CARD with RCA, R1.
sd_cmd7:
            LOAD     sC, 07                ; 0A6  CMD7
            LOAD     sB, 15                ; 0A7
            FETCH    sA, 17                ; 0A8
            FETCH    s9, 18                ; 0A9
            JUMP     sd_cmd_arg_hi         ; 0AA

; sd_acmd6: SET_BUS_WIDTH, argument 2 (4-bit). Sent after CMD55.
sd_acmd6:
            LOAD     sC, 06                ; 0AB  ACMD6
            LOAD     sB, 15                ; 0AC
            LOAD     s8, 00                ; 0AD
            LOAD     s7, 02                ; 0AE  argument 2: 4-bit bus
            JUMP     sd_cmd_arg16          ; 0AF

; sd_cmd16: SET_BLOCKLEN, argument s1:s0 (called with 0200).
sd_cmd16:
            LOAD     sC, 10                ; 0B0  CMD16
            LOAD     sB, 15                ; 0B1
            LOAD     s8, s1                ; 0B2
            LOAD     s7, s0                ; 0B3
            JUMP     sd_cmd_arg16          ; 0B4
sd_cmd_noarg:
            LOAD     s8, 00                ; 0B5
            LOAD     s7, 00                ; 0B6
sd_cmd_arg16:
            LOAD     sA, 00                ; 0B7
            LOAD     s9, 00                ; 0B8
            CALL     sd_cmd                ; 0B9
            RETURN                         ; 0BA

; ------------------------------------------------------------------------------
; sdc_init_regs: initial SD host controller setup: clear timeouts and event
; enables/status, 1-bit bus, pulse software reset, clock divider 48 (slow
; clock for card identification).
; ------------------------------------------------------------------------------
sdc_init_regs:
            CALL     sdc_reg20_clear       ; 0BB  reg 20 = 0
            CALL     sdc_reg18_clear       ; 0BC  reg 18 = 0
            CALL     sdc_reg38_clear       ; 0BD  reg 38 = 0 (cmd events off)
            CALL     sdc_reg40_clear       ; 0BE  reg 40 = 0 (data events off)
            CALL     sdc_reg34_clear       ; 0BF  reg 34 = 0 (clear cmd events)
            CALL     sdc_reg3C_clear       ; 0C0  reg 3C = 0 (clear data events)
            LOAD     s0, 00                ; 0C1
            CALL     sdc_set_clkdiv        ; 0C2  reg 24 = 0
            CALL     sdc_bus1              ; 0C3  reg 1C = 0: 1-bit bus
            CALL     sdc_reset_on          ; 0C4  reg 28 = 1: reset
            LOAD     s0, 48                ; 0C5  clock divider 48: slow identification clock
            CALL     sdc_set_clkdiv        ; 0C6
            CALL     sdc_reset_off         ; 0C7  reg 28 = 0: release reset
            RETURN                         ; 0C8
sdc_reset_on:
            LOAD     sE, 28                ; 0C9
            CALL     wb_clear_hi           ; 0CA
            JUMP     wb_write_1            ; 0CB
sdc_reg20_clear:
            LOAD     sE, 20                ; 0CC
            LOAD     sD, 00                ; 0CD
            OUTPUT   sD, 73                ; 0CE
            OUTPUT   sD, 72                ; 0CF
            LOAD     s1, 00                ; 0D0
            OUTPUT   s1, 71                ; 0D1
            OUTPUT   s1, 70                ; 0D2
            CALL     wb_write              ; 0D3
            RETURN                         ; 0D4
sdc_reg18_clear:
            LOAD     sE, 18                ; 0D5
            JUMP     wb_write_0            ; 0D6
sdc_set_clkdiv:
            LOAD     sE, 24                ; 0D7
            CALL     wb_clear_hi           ; 0D8
            LOAD     sD, s0                ; 0D9
            OUTPUT   sD, 70                ; 0DA
            CALL     wb_write              ; 0DB
            RETURN                         ; 0DC
sdc_reset_off:
            LOAD     sE, 28                ; 0DD
            JUMP     wb_write_0            ; 0DE
sdc_reg38_clear:
            LOAD     sE, 38                ; 0DF
            JUMP     wb_write_0            ; 0E0
sdc_reg34_clear:
            LOAD     sE, 34                ; 0E1
            JUMP     wb_write_0            ; 0E2
sdc_reg40_set:
            LOAD     sE, 40                ; 0E3
            CALL     wb_clear_hi           ; 0E4
            JUMP     wb_write_1            ; 0E5
sdc_reg40_clear:
            LOAD     sE, 40                ; 0E6
            JUMP     wb_write_0            ; 0E7
sdc_reg3C_clear:
            LOAD     sE, 3C                ; 0E8
            JUMP     wb_write_0            ; 0E9
sdc_bus4:
            LOAD     sE, 1C                ; 0EA
            CALL     wb_clear_hi           ; 0EB

; wb_write_1 / wb_write_0: write 00000001 / 00000000 to Wishbone register sE.
wb_write_1:
            LOAD     s1, 01                ; 0EC
            OUTPUT   s1, 70                ; 0ED
            CALL     wb_write              ; 0EE
            RETURN                         ; 0EF
sdc_bus1:
            LOAD     sE, 1C                ; 0F0
            JUMP     wb_write_0            ; 0F1
wb_write_0:
            CALL     wb_clear_hi           ; 0F2
            OUTPUT   sD, 70                ; 0F3
            CALL     wb_write              ; 0F4
            RETURN                         ; 0F5

; wb_clear_hi: zero the upper three staging bytes (ports 71-73); sD = 0.
wb_clear_hi:
            LOAD     sD, 00                ; 0F6
            OUTPUT   sD, 73                ; 0F7
            OUTPUT   sD, 72                ; 0F8
            OUTPUT   sD, 71                ; 0F9
            RETURN                         ; 0FA

; ------------------------------------------------------------------------------
; sd_cmd: send SD command.
;   in: sC = index, sB = flags (see header), s7-sA = argument (s7 = LSB),
;       scratch 19 = data phase (01 read, 02 write, 00 none),
;       1A-1D = DMA address, 1E-1F = block size - 1, 20 = block count - 1.
; Builds the controller's command word in s0, programs the data registers if a
; data phase is requested, issues the command, waits for the command event,
; then (for data commands) waits for the data event.
; ------------------------------------------------------------------------------
sd_cmd:
            LOAD     s0, 00                ; 0FB
            TEST     sB, 01                ; 0FC  b0: response expected
            JUMP     Z, sd_cmd_L08         ; 0FD
            TEST     sB, 02                ; 0FE  b1: long response
            JUMP     Z, sd_cmd_L07         ; 0FF
            OR       s0, 02                ; 100  -> 136-bit
            JUMP     sd_cmd_L08            ; 101
sd_cmd_L07:
            OR       s0, 01                ; 102  -> 48-bit
sd_cmd_L08:
            TEST     sB, 08                ; 103  sB b3 -> busy check
            JUMP     Z, sd_cmd_L0B         ; 104
            OR       s0, 04                ; 105
sd_cmd_L0B:
            TEST     sB, 04                ; 106  sB b2 -> CRC check
            JUMP     Z, sd_cmd_L0E         ; 107
            OR       s0, 08                ; 108
sd_cmd_L0E:
            TEST     sB, 10                ; 109  sB b4 -> index check
            JUMP     Z, sd_cmd_L11         ; 10A
            OR       s0, 10                ; 10B
sd_cmd_L11:
            FETCH    s1, 19                ; 10C  data phase?
            COMPARE  s1, 01                ; 10D
            JUMP     NZ, sd_cmd_L16        ; 10E
            OR       s0, 20                ; 10F  read data
            JUMP     sd_cmd_data           ; 110
sd_cmd_L16:
            COMPARE  s1, 02                ; 111
            JUMP     NZ, sd_cmd_issue      ; 112
            OR       s0, 40                ; 113  write data
sd_cmd_data:
            LOAD     sE, 60                ; 114  reg 60: DMA address from scratch 1A-1D
            FETCH    s1, 1A                ; 115
            OUTPUT   s1, 73                ; 116
            FETCH    s1, 1B                ; 117
            OUTPUT   s1, 72                ; 118
            FETCH    s1, 1C                ; 119
            OUTPUT   s1, 71                ; 11A
            FETCH    s1, 1D                ; 11B
            OUTPUT   s1, 70                ; 11C
            CALL     wb_write              ; 11D
            LOAD     sE, 44                ; 11E  reg 44: block size - 1
            LOAD     s1, 00                ; 11F
            OUTPUT   s1, 73                ; 120
            OUTPUT   s1, 72                ; 121
            FETCH    s1, 1E                ; 122
            OUTPUT   s1, 71                ; 123
            FETCH    s1, 1F                ; 124
            OUTPUT   s1, 70                ; 125
            CALL     wb_write              ; 126
            LOAD     sE, 48                ; 127  reg 48: block count - 1
            CALL     wb_clear_hi           ; 128
            FETCH    s1, 20                ; 129
            OUTPUT   s1, 70                ; 12A
            CALL     wb_write              ; 12B
sd_cmd_issue:
            LOAD     sE, 04                ; 12C  reg 04: command (index, flags)
            OUTPUT   sC, 71                ; 12D
            OUTPUT   s0, 70                ; 12E
            CALL     wb_write              ; 12F
            LOAD     sE, 00                ; 130  reg 00: argument; this starts the command
            OUTPUT   sA, 73                ; 131
            OUTPUT   s9, 72                ; 132
            OUTPUT   s8, 71                ; 133
            OUTPUT   s7, 70                ; 134
            CALL     wb_write              ; 135
sd_cmd_wait:
            LOAD     sE, 34                ; 136  wait for command event
            CALL     wb_wait_ack           ; 137
            INPUT    s0, 70                ; 138
            COMPARE  s0, 06                ; 139  06: error bits
            JUMP     Z, sd_cmd_done        ; 13A
            TEST     s0, 01                ; 13B  b0: command complete
            JUMP     Z, sd_cmd_wait        ; 13C
sd_cmd_done:
            LOAD     sE, 34                ; 13D  clear command events
            LOAD     sD, 00                ; 13E
            OUTPUT   sD, 70                ; 13F
            CALL     wb_write              ; 140
            FETCH    s1, 19                ; 141  data phase?
            COMPARE  s1, 00                ; 142
            JUMP     Z, sd_cmd_ret         ; 143
            LOAD     sF, 55                ; 144  debug 55
            CALL     dbg_putc              ; 145
sd_data_wait:
            LOAD     sE, 3C                ; 146  wait for data event (b0 = transfer complete)
            CALL     wb_wait_ack           ; 147
            INPUT    s3, 70                ; 148
            TEST     s3, 01                ; 149
            JUMP     Z, sd_data_wait       ; 14A
            STORE    s3, 3D                ; 14B  keep data status
            LOAD     sE, 3C                ; 14C  clear data events
            LOAD     sD, 00                ; 14D
            OUTPUT   sD, 70                ; 14E
            CALL     wb_write              ; 14F
            LOAD     s1, 00                ; 150  data phase done
            STORE    s1, 19                ; 151
sd_cmd_ret:
            RETURN                         ; 152

; sd_get_resp: read response register 08 into scratch 02-05 (02 = MSB).
sd_get_resp:
            LOAD     sE, 08                ; 153  register 08 = response
            JUMP     sd_get_resp_L02       ; 154
sd_get_resp_L02:
            CALL     wb_wait_ack           ; 155
            INPUT    s6, 73                ; 156
            STORE    s6, 02                ; 157
            INPUT    s5, 72                ; 158
            STORE    s5, 03                ; 159
            INPUT    s4, 71                ; 15A
            STORE    s4, 04                ; 15B
            INPUT    s3, 70                ; 15C
            STORE    s3, 05                ; 15D
            RETURN                         ; 15E

; sd_save_cid: read the response and copy it to scratch 13-16.
sd_save_cid:
            CALL     sd_get_resp           ; 15F
            FETCH    s0, 05                ; 160
            STORE    s0, 16                ; 161
            FETCH    s0, 04                ; 162
            STORE    s0, 15                ; 163
            FETCH    s0, 03                ; 164
            STORE    s0, 14                ; 165
            FETCH    s0, 02                ; 166
            STORE    s0, 13                ; 167
            RETURN                         ; 168

; ------------------------------------------------------------------------------
; dbg_putc: send sF to the debug output (port A1) once A0 bit 2 is clear.
; Probably a UART or similar; the codes it sends are progress markers.
; ------------------------------------------------------------------------------
dbg_putc:
            INPUT    s0, A0                ; 169  debug TX busy?
            TEST     s0, 04                ; 16A
            JUMP     NZ, dbg_putc          ; 16B
            OUTPUT   sF, A1                ; 16C  send byte
            RETURN                         ; 16D

; wb_write: write the 32-bit value staged in ports 70-73 to Wishbone register
; sE (the port number is the register address), then wait for the ack.
; wb_wait_ack: wait until reading register sE returns b1:0 != 0 (also used on
; its own to start a register read; data then appears on input ports 70-73).
wb_write:
            OUTPUT   sD, (sE)              ; 16E  start write cycle to register sE
            JUMP     wb_wait_ack           ; 16F
wb_wait_ack:
            INPUT    sD, (sE)              ; 170  read register sE
            TEST     sD, 03                ; 171  ack/done bits
            JUMP     Z, wb_wait_ack        ; 172
            RETURN                         ; 173

; ------------------------------------------------------------------------------
; DELAYS (nested countdown loops; instruction counts measured by emulation):
;   delay_s  ~1.1k instr   delay_m ~27k   delay_l ~543k   delay_l_half ~271k
; ------------------------------------------------------------------------------
delay_tiny:
            LOAD     s0, 03                ; 174  [unreachable]
delay_tiny_L01:
            SUB      s0, 01                ; 175  [unreachable]
            JUMP     NZ, delay_tiny_L01    ; 176  [unreachable]
            RETURN                         ; 177  [unreachable]
delay_11:
            LOAD     s0, 0B                ; 178
delay_11_L01:
            SUB      s0, 01                ; 179
            JUMP     NZ, delay_11_L01      ; 17A
            RETURN                         ; 17B
delay_s:
            LOAD     s1, 28                ; 17C
delay_s_L01:
            CALL     delay_11              ; 17D
            SUB      s1, 01                ; 17E
            JUMP     NZ, delay_s_L01       ; 17F
            RETURN                         ; 180
delay_m:
            LOAD     s2, 19                ; 181
delay_m_L01:
            CALL     delay_s               ; 182
            SUB      s2, 01                ; 183
            JUMP     NZ, delay_m_L01       ; 184
            RETURN                         ; 185
delay_l:
            LOAD     s3, 14                ; 186
delay_l_L01:
            CALL     delay_m               ; 187
            SUB      s3, 01                ; 188
            JUMP     NZ, delay_l_L01       ; 189
            RETURN                         ; 18A
delay_l_half:
            LOAD     s3, 0A                ; 18B  [unreachable]
delay_l_half_L01:
            CALL     delay_m               ; 18C  [unreachable]
            SUB      s3, 01                ; 18D  [unreachable]
            JUMP     NZ, delay_l_half_L01  ; 18E  [unreachable]
            RETURN                         ; 18F  [unreachable]
delay_xl:
            LOAD     s4, 19                ; 190  [unreachable]
delay_xl_L01:
            CALL     delay_l               ; 191  [unreachable]
            SUB      s4, 01                ; 192  [unreachable]
            JUMP     NZ, delay_xl_L01      ; 193  [unreachable]
            RETURN                         ; 194  [unreachable]

; ------------------------------------------------------------------------------
; SECTOR TRANSFERS. In: s7-sA = card address, scratch 20 = block count - 1.
; DMA address = 0, i.e. the start of the 2 KB sector buffer the Game Boy sees
; at $A000 ($7F30 = 01).
; sd_read_multi:  CMD18 READ_MULTIPLE_BLOCK
; sd_write_multi: CMD25 WRITE_MULTIPLE_BLOCK
; sd_write_single: CMD24 (only reachable via fall-through, unused)
; ------------------------------------------------------------------------------
sd_read_multi:
            LOAD     sC, 12                ; 195  CMD18
            LOAD     s1, 01                ; 196  data phase: read
sd_xfer_dir:
            STORE    s1, 19                ; 197
            CALL     sd_xfer_start         ; 198
            RETURN                         ; 199
sd_write_single:
            LOAD     sC, 18                ; 19A  [unreachable] CMD24
sd_write_single_L01:
            LOAD     s1, 02                ; 19B  data phase: write
            JUMP     sd_xfer_dir           ; 19C
sd_write_multi:
            LOAD     sC, 19                ; 19D  CMD25
            JUMP     sd_write_single_L01   ; 19E

; sd_xfer_start: DMA address 0, block size 512, enable data events, then send
; the command with an R1 response. (No 99 + address debug output in this
; version.)
sd_xfer_start:
            LOAD     s1, 00                ; 19F
            STORE    s1, 1C                ; 1A0  DMA address = 0
            STORE    s1, 1A                ; 1A1
            STORE    s1, 1B                ; 1A2
            STORE    s1, 1D                ; 1A3
            LOAD     s1, 01                ; 1A4  block size - 1 = 01FF
            STORE    s1, 1E                ; 1A5
            LOAD     s1, FF                ; 1A6
            STORE    s1, 1F                ; 1A7
            FETCH    s1, 20                ; 1A8
            CALL     sdc_reg40_set         ; 1A9  reg 40 = 1: data events on
            LOAD     sB, 15                ; 1AA  R1
            CALL     sd_cmd                ; 1AB
            RETURN                         ; 1AC

; sd_cmd12: STOP_TRANSMISSION, R1b.
sd_cmd12:
            LOAD     sC, 0C                ; 1AD  CMD12
            LOAD     sB, 1D                ; 1AE  R1b
            CALL     sd_cmd_noarg          ; 1AF
            RETURN                         ; 1B0

; ------------------------------------------------------------------------------
; rom_load (event 20, Game Boy $7F36 = 03): as in FW4, with one addition:
; port BB is sampled into scratch 2B at the start, and the per-cluster wait
; (delay_l) is skipped when it reads 11. BB probably mirrors $7FBB; its meaning
; is not known.
; ------------------------------------------------------------------------------
rom_load:
            FETCH    sF, 3E                ; 1B1  debug: licence flags
            CALL     dbg_putc              ; 1B2
            FETCH    sF, 3F                ; 1B3
            CALL     dbg_putc              ; 1B4
            FETCH    s0, 3E                ; 1B5  licensed?
            COMPARE  s0, F1                ; 1B6
            RETURN NZ                      ; 1B7
            FETCH    s0, 3F                ; 1B8
            COMPARE  s0, F2                ; 1B9
            RETURN NZ                      ; 1BA
            LOAD     s5, 7E                ; 1BB  table word 7E: sectors per cluster
            CALL     table_read            ; 1BC
            STORE    s0, 2A                ; 1BD
            STORE    s1, 31                ; 1BE
            SUB      s0, 01                ; 1BF  block count - 1 = one cluster
            STORE    s0, 20                ; 1C0
            LOAD     s5, 7D                ; 1C1  table word 7D must be 1
            CALL     table_read            ; 1C2
            COMPARE  s0, 01                ; 1C3
            JUMP     Z, rom_load_go        ; 1C4
            RETURN                         ; 1C5
rom_load_go:
            LOAD     s0, 01                ; 1C6  busy flag for the GB-visible status
            OUTPUT   s0, EF                ; 1C7
            INPUT    s0, BB                ; 1C8  sample port BB
            STORE    s0, 2B                ; 1C9
            CALL     rom_load_file         ; 1CA
            LOAD     s0, 00                ; 1CB  done
            OUTPUT   s0, EF                ; 1CC
            RETURN                         ; 1CD
rom_load_file:
            LOAD     s0, 00                ; 1CE  start at file sector 0
            STORE    s0, 2C                ; 1CF
            STORE    s0, 2D                ; 1D0
            STORE    s0, 2E                ; 1D1
            STORE    s0, 2F                ; 1D2
            LOAD     s1, 00                ; 1D3  load-table page 0
            STORE    s1, 3B                ; 1D4
rom_load_cluster:
            FETCH    s7, 2F                ; 1D5  tell the destination which file sector comes next
            OUTPUT   s7, E0                ; 1D6
            FETCH    s8, 2E                ; 1D7
            OUTPUT   s8, E1                ; 1D8
            FETCH    s9, 2D                ; 1D9
            OUTPUT   s9, E2                ; 1DA
            FETCH    sA, 2C                ; 1DB
            OUTPUT   sA, E3                ; 1DC
            CALL     map_sector            ; 1DD  file sector -> card address
            CALL     sd_read_multi         ; 1DE  read one cluster
            CALL     sd_cmd12              ; 1DF  stop
            FETCH    s0, 2B                ; 1E0  BB = 11: skip the per-cluster wait
            COMPARE  s0, 11                ; 1E1
            JUMP     Z, rom_load_next      ; 1E2
            CALL     delay_l               ; 1E3  wait (lets the cluster drain into cartridge memory?)
rom_load_next:
            FETCH    s7, 2F                ; 1E4  file sector += sectors per cluster
            FETCH    s8, 2E                ; 1E5
            FETCH    s9, 2D                ; 1E6
            FETCH    sA, 2C                ; 1E7
            FETCH    s0, 2A                ; 1E8
            FETCH    s1, 31                ; 1E9
            ADD      s7, s0                ; 1EA
            ADDCY    s8, s1                ; 1EB
            ADDCY    s9, 00                ; 1EC
            ADDCY    sA, 00                ; 1ED
            STORE    s7, 2F                ; 1EE
            STORE    s8, 2E                ; 1EF
            STORE    s9, 2D                ; 1F0
            STORE    sA, 2C                ; 1F1
            LOAD     s5, 7C                ; 1F2  table word 7C: file size
            CALL     table_read            ; 1F3
            SL0      s7                    ; 1F4  file sector * 2 < size / 256  <=>  file sector * 512 < size
            SLA      s8                    ; 1F5
            SLA      s9                    ; 1F6
            SLA      sA                    ; 1F7
            SUB      s7, s1                ; 1F8
            SUBCY    s8, s2                ; 1F9
            SUBCY    s9, s3                ; 1FA
            JUMP     C, rom_load_cluster   ; 1FB  more to load
            RETURN                         ; 1FC

; ------------------------------------------------------------------------------
; UNREACHABLE (1FD-298): older code driving a 24-bit address (E4-E6) and
; control port (E7) in loops of 400h/800h steps: probably a copy/clear of the
; save RAM or PSRAM from an earlier design. Nothing calls it; removed in FW5.
; ------------------------------------------------------------------------------
old_wait_b7:
            INPUT    s1, B7                ; 1FD  [unreachable]
            COMPARE  s1, 00                ; 1FE  [unreachable]
            JUMP     Z, old_wait_b7        ; 1FF  [unreachable]
            LOAD     sF, AA                ; 200  [unreachable]
            CALL     dbg_putc              ; 201  [unreachable]
            LOAD     s4, 03                ; 202  [unreachable]
            STORE    s4, 20                ; 203  [unreachable]
            LOAD     s4, 01                ; 204  [unreachable]
            OUTPUT   s4, E7                ; 205  [unreachable]
            LOAD     s4, 00                ; 206  [unreachable]
            STORE    s4, 33                ; 207  [unreachable]
            STORE    s4, 34                ; 208  [unreachable]
            STORE    s4, 35                ; 209  [unreachable]
            STORE    s4, 36                ; 20A  [unreachable]
            RETURN                         ; 20B  [unreachable]
old_bus_fill:
            LOAD     s0, 00                ; 20C  [unreachable]
            LOAD     s1, 00                ; 20D  [unreachable]
            LOAD     s2, 00                ; 20E  [unreachable]
old_bus_fill_L03:
            FETCH    s4, 38                ; 20F  [unreachable]
            FETCH    s5, 39                ; 210  [unreachable]
            ADD      s4, s1                ; 211  [unreachable]
            ADDCY    s5, s2                ; 212  [unreachable]
            OUTPUT   s5, E6                ; 213  [unreachable]
            OUTPUT   s4, E5                ; 214  [unreachable]
            OUTPUT   s0, E4                ; 215  [unreachable]
            LOAD     s6, 03                ; 216  [unreachable]
            OUTPUT   s6, E7                ; 217  [unreachable]
            LOAD     s6, 01                ; 218  [unreachable]
            OUTPUT   s6, E7                ; 219  [unreachable]
            ADD      s0, 01                ; 21A  [unreachable]
            ADDCY    s1, 00                ; 21B  [unreachable]
            COMPARE  s1, 04                ; 21C  [unreachable]
            JUMP     Z, old_bus_fill_L13   ; 21D  [unreachable]
            JUMP     old_bus_fill_L03      ; 21E  [unreachable]
old_bus_fill_L13:
            RETURN                         ; 21F  [unreachable]
old_get_33:
            FETCH    s7, 33                ; 220  [unreachable]
            FETCH    s8, 34                ; 221  [unreachable]
            FETCH    s9, 35                ; 222  [unreachable]
            FETCH    sA, 36                ; 223  [unreachable]
            RETURN                         ; 224  [unreachable]
old_step:
            CALL     old_bus_fill          ; 225  [unreachable]
            FETCH    s1, 38                ; 226  [unreachable]
            FETCH    s2, 39                ; 227  [unreachable]
            ADD      s1, 04                ; 228  [unreachable]
            ADDCY    s2, 00                ; 229  [unreachable]
            STORE    s1, 38                ; 22A  [unreachable]
            STORE    s2, 39                ; 22B  [unreachable]
            CALL     old_get_33            ; 22C  [unreachable]
            CALL     map_sector            ; 22D  [unreachable]
            COMPARE  s7, 00                ; 22E  [unreachable]
            JUMP     NZ, old_step_L12      ; 22F  [unreachable]
            COMPARE  s8, 00                ; 230  [unreachable]
            JUMP     NZ, old_step_L12      ; 231  [unreachable]
            COMPARE  s9, 00                ; 232  [unreachable]
            JUMP     NZ, old_step_L12      ; 233  [unreachable]
            COMPARE  sA, 00                ; 234  [unreachable]
            JUMP     NZ, old_step_L12      ; 235  [unreachable]
            RETURN                         ; 236  [unreachable]
old_step_L12:
            CALL     sd_write_multi        ; 237  [unreachable]
            CALL     sd_cmd12              ; 238  [unreachable]
            CALL     old_get_33            ; 239  [unreachable]
            ADD      s7, 04                ; 23A  [unreachable]
            ADDCY    s8, 00                ; 23B  [unreachable]
            ADDCY    s9, 00                ; 23C  [unreachable]
            ADDCY    sA, 00                ; 23D  [unreachable]
            STORE    s7, 33                ; 23E  [unreachable]
            STORE    s8, 34                ; 23F  [unreachable]
            STORE    s9, 35                ; 240  [unreachable]
            STORE    sA, 36                ; 241  [unreachable]
            RETURN                         ; 242  [unreachable]
old_copy_a:
            CALL     old_wait_b7           ; 243  [unreachable]
            STORE    s4, 39                ; 244  [unreachable]
            STORE    s4, 38                ; 245  [unreachable]
            STORE    s4, 37                ; 246  [unreachable]
            LOAD     s1, FF                ; 247  [unreachable]
            STORE    s1, 3B                ; 248  [unreachable]
old_copy_a_L06:
            CALL     old_step              ; 249  [unreachable]
            LOAD     s5, 7F                ; 24A  [unreachable]
            CALL     table_read            ; 24B  [unreachable]
            SL0      s7                    ; 24C  [unreachable]
            SLA      s8                    ; 24D  [unreachable]
            SLA      s9                    ; 24E  [unreachable]
            SLA      sA                    ; 24F  [unreachable]
            SUB      s7, s1                ; 250  [unreachable]
            SUBCY    s8, s2                ; 251  [unreachable]
            SUBCY    s9, 00                ; 252  [unreachable]
            JUMP     C, old_copy_a_L06     ; 253  [unreachable]
            LOAD     s4, 00                ; 254  [unreachable]
            OUTPUT   s4, E7                ; 255  [unreachable]
            LOAD     sF, DF                ; 256  [unreachable]
            CALL     dbg_putc              ; 257  [unreachable]
            RETURN                         ; 258  [unreachable]
old_copy_b:
            CALL     old_wait_b7           ; 259  [unreachable]
            STORE    s4, 37                ; 25A  [unreachable]
            STORE    s4, 38                ; 25B  [unreachable]
            LOAD     s4, 02                ; 25C  [unreachable]
            STORE    s4, 39                ; 25D  [unreachable]
            LOAD     s1, F3                ; 25E  [unreachable]
            STORE    s1, 3B                ; 25F  [unreachable]
old_copy_b_L07:
            CALL     old_step              ; 260  [unreachable]
            LOAD     s0, 00                ; 261  [unreachable]
            LOAD     s1, 00                ; 262  [unreachable]
            LOAD     s2, 07                ; 263  [unreachable]
            LOAD     s3, 00                ; 264  [unreachable]
            SL0      s7                    ; 265  [unreachable]
            SLA      s8                    ; 266  [unreachable]
            SLA      s9                    ; 267  [unreachable]
            SLA      sA                    ; 268  [unreachable]
            SUB      s7, s1                ; 269  [unreachable]
            SUBCY    s8, s2                ; 26A  [unreachable]
            SUBCY    s9, 00                ; 26B  [unreachable]
            JUMP     C, old_copy_b_L07     ; 26C  [unreachable]
            LOAD     s4, 00                ; 26D  [unreachable]
            OUTPUT   s4, E7                ; 26E  [unreachable]
            LOAD     sF, DA                ; 26F  [unreachable]
            CALL     dbg_putc              ; 270  [unreachable]
            RETURN                         ; 271  [unreachable]
old_copy_c:
            INPUT    s5, A2                ; 272  [unreachable]
            INPUT    s6, A3                ; 273  [unreachable]
            COMPARE  s0, EF                ; 274  [unreachable]
            JUMP     NZ, old_copy_c_L06    ; 275  [unreachable]
            LOAD     s5, 00                ; 276  [unreachable]
            LOAD     s6, 00                ; 277  [unreachable]
old_copy_c_L06:
            LOAD     s4, 01                ; 278  [unreachable]
            OUTPUT   s4, E7                ; 279  [unreachable]
            STORE    s5, 38                ; 27A  [unreachable]
            STORE    s6, 37                ; 27B  [unreachable]
            LOAD     s4, 00                ; 27C  [unreachable]
            OUTPUT   s4, E6                ; 27D  [unreachable]
            LOAD     s0, 00                ; 27E  [unreachable]
            LOAD     s1, 00                ; 27F  [unreachable]
            LOAD     s2, 00                ; 280  [unreachable]
old_copy_c_L0F:
            FETCH    s4, 37                ; 281  [unreachable]
            FETCH    s5, 38                ; 282  [unreachable]
            ADD      s4, s0                ; 283  [unreachable]
            ADDCY    s5, s1                ; 284  [unreachable]
            OUTPUT   s5, E5                ; 285  [unreachable]
            OUTPUT   s4, E4                ; 286  [unreachable]
            LOAD     s4, 05                ; 287  [unreachable]
            OUTPUT   s4, E7                ; 288  [unreachable]
            LOAD     s4, 01                ; 289  [unreachable]
            OUTPUT   s4, E7                ; 28A  [unreachable]
            ADD      s0, 01                ; 28B  [unreachable]
            ADDCY    s1, 00                ; 28C  [unreachable]
            ADDCY    s2, 00                ; 28D  [unreachable]
            COMPARE  s6, EF                ; 28E  [unreachable]
            JUMP     Z, old_copy_c_L21     ; 28F  [unreachable]
            COMPARE  s1, 08                ; 290  [unreachable]
            JUMP     Z, old_copy_c_L24     ; 291  [unreachable]
            JUMP     old_copy_c_L0F        ; 292  [unreachable]
old_copy_c_L21:
            COMPARE  s2, 01                ; 293  [unreachable]
            JUMP     Z, old_copy_c_L24     ; 294  [unreachable]
            JUMP     old_copy_c_L0F        ; 295  [unreachable]
old_copy_c_L24:
            LOAD     s4, 00                ; 296  [unreachable]
            OUTPUT   s4, E7                ; 297  [unreachable]
            RETURN                         ; 298  [unreachable]

; ------------------------------------------------------------------------------
; table_page / table_read: read 32-bit word s5 (+ page offset from scratch 3B)
; of the load table into s3:s2:s1:s0 (s0 = LSB) via port BF and C0-C3.
; ------------------------------------------------------------------------------
table_page:
            LOAD     s5, s6                ; 299
            FETCH    s4, 3B                ; 29A  page select
            COMPARE  s4, 00                ; 29B
            JUMP     Z, table_page_L09     ; 29C
            COMPARE  s4, FF                ; 29D
            JUMP     Z, table_page_L08     ; 29E
            ADD      s5, C0                ; 29F  page C0
            RETURN                         ; 2A0
table_page_L08:
            ADD      s5, 80                ; 2A1  page 80
table_page_L09:
            RETURN                         ; 2A2
table_read:
            OUTPUT   s5, BF                ; 2A3  word index
            LOAD     s1, s1                ; 2A4
            LOAD     s1, s1                ; 2A5
            LOAD     s1, s1                ; 2A6
            INPUT    s3, C0                ; 2A7  b31:24
            INPUT    s2, C1                ; 2A8
            INPUT    s1, C2                ; 2A9
            INPUT    s0, C3                ; 2AA  b7:0
            RETURN                         ; 2AB

; ------------------------------------------------------------------------------
; map_sector: translate a file sector offset (s7-sA) into an LBA using the
; {offset, LBA} pairs: find the last pair whose offset <= file sector, then
; LBA = pair.LBA + (file sector - pair.offset). Converts to a byte address for
; standard-capacity cards (lba_to_addr).
; ------------------------------------------------------------------------------
map_sector:
            LOAD     s6, 02                ; 2AC  pair index 2, 4, 6, ...
map_sector_L01:
            CALL     table_page            ; 2AD
            CALL     table_read            ; 2AE
            LOAD     s4, s7                ; 2AF  compare file sector with pair offset
            SUB      s4, s0                ; 2B0
            LOAD     s4, s8                ; 2B1
            SUBCY    s4, s1                ; 2B2
            LOAD     s4, s9                ; 2B3
            SUBCY    s4, s2                ; 2B4
            LOAD     s4, sA                ; 2B5
            SUBCY    s4, s3                ; 2B6
            JUMP     C, map_sector_L10     ; 2B7  file sector < offset: use previous pair
            COMPARE  s6, 7C                ; 2B8  end of table
            JUMP     Z, map_sector_L12     ; 2B9
            ADD      s6, 02                ; 2BA
            JUMP     map_sector_L01        ; 2BB
map_sector_L10:
            SUB      s6, 02                ; 2BC
            JUMP     map_sector_L13        ; 2BD
map_sector_L12:
            LOAD     s6, 00                ; 2BE  end of table reached: fall back to pair 0
map_sector_L13:
            CALL     table_page            ; 2BF
            CALL     table_read            ; 2C0
            SUB      s7, s0                ; 2C1  file sector - offset
            SUBCY    s8, s1                ; 2C2
            SUBCY    s9, s2                ; 2C3
            SUBCY    sA, s3                ; 2C4
            ADD      s6, 01                ; 2C5
            CALL     table_page            ; 2C6
            CALL     table_read            ; 2C7
            ADD      s7, s0                ; 2C8  + LBA
            ADDCY    s8, s1                ; 2C9
            ADDCY    s9, s2                ; 2CA
            ADDCY    sA, s3                ; 2CB
            CALL     lba_to_addr           ; 2CC
            RETURN                         ; 2CD

; lba_to_addr: for SDSC cards (scratch 06 != 1) multiply s7-sA by 512.
lba_to_addr:
            FETCH    s4, 06                ; 2CE
            COMPARE  s4, 01                ; 2CF  high capacity: block address as is
            JUMP     Z, lba_to_addr_L0A    ; 2D0
            LOAD     sA, s9                ; 2D1  SDSC: byte address = sector * 512
            LOAD     s9, s8                ; 2D2
            LOAD     s8, s7                ; 2D3
            SL0      s8                    ; 2D4
            SLA      s9                    ; 2D5
            SLA      sA                    ; 2D6
            LOAD     s7, 00                ; 2D7
lba_to_addr_L0A:
            RETURN                         ; 2D8

; get_gb_sector: s7-sA = sector number from $7FB0-$7FB3 (converted for SDSC),
; scratch 20 = ($7FB4 count) - 1. (Bit 7 of $7FB4, the write flag, is presumably
; removed by the hardware, which reports it as event 40 instead.)
get_gb_sector:
            INPUT    sA, B3                ; 2D9  $7FB3
            INPUT    s9, B2                ; 2DA
            INPUT    s8, B1                ; 2DB
            INPUT    s7, B0                ; 2DC  $7FB0
            CALL     lba_to_addr           ; 2DD
            INPUT    s1, B4                ; 2DE  $7FB4
            SUB      s1, 01                ; 2DF
            STORE    s1, 20                ; 2E0  block count - 1
            RETURN                         ; 2E1

; Unreachable: pulse port E9.
old_pulse_e9:
            LOAD     s0, 00                ; 2E2  [unreachable]
            OUTPUT   s0, E9                ; 2E3  [unreachable]
            LOAD     s0, 01                ; 2E4  [unreachable]
            OUTPUT   s0, E9                ; 2E5  [unreachable]
            CALL     delay_tiny            ; 2E6  [unreachable]
            LOAD     s0, 00                ; 2E7  [unreachable]
            OUTPUT   s0, E9                ; 2E8  [unreachable]
            LOAD     s0, 00                ; 2E9  [unreachable]
            RETURN                         ; 2EA  [unreachable]

; ------------------------------------------------------------------------------
; BIT-BANGED I2C on port EC (b0 SCL, b1 SDA, sF = shadow) / EB (inputs).
; SCL high waits for the line to actually rise (clock stretching).
; i2c_write_byte: s5 MSB first.  i2c_read_byte: 8 bits into s5.
; i2c_get_ack: clock in the ACK bit; returns carry = 1 on NACK.
; ------------------------------------------------------------------------------
i2c_idle:
            LOAD     sF, 01                ; 2EB  SCL and SDA released
            OR       sF, 02                ; 2EC
            OUTPUT   sF, EC                ; 2ED
            RETURN                         ; 2EE
i2c_start:
            CALL     i2c_sda_high          ; 2EF
            CALL     i2c_scl_high          ; 2F0
            CALL     i2c_delay5            ; 2F1
            CALL     i2c_sda_low           ; 2F2  SDA low while SCL high = START
            CALL     i2c_delay4            ; 2F3
            CALL     i2c_scl_low           ; 2F4
            RETURN                         ; 2F5
i2c_stop:
            CALL     i2c_sda_low           ; 2F6
            CALL     i2c_delay5            ; 2F7
            CALL     i2c_scl_high          ; 2F8
            CALL     i2c_delay4            ; 2F9
            CALL     i2c_sda_high          ; 2FA  SDA high while SCL high = STOP
            RETURN                         ; 2FB
i2c_write_byte:
            LOAD     s1, 80                ; 2FC  bit mask
i2c_write_byte_L01:
            TEST     s5, s1                ; 2FD
            JUMP     NZ, i2c_write_byte_L05 ; 2FE
            CALL     i2c_sda_low           ; 2FF  bit = 0
            JUMP     i2c_write_byte_L06    ; 300
i2c_write_byte_L05:
            CALL     i2c_sda_high          ; 301  bit = 1
i2c_write_byte_L06:
            CALL     i2c_clock             ; 302
            SR0      s1                    ; 303  next bit; carry out after bit 0
            RETURN C                       ; 304
            JUMP     i2c_write_byte_L01    ; 305
i2c_read_byte:
            LOAD     s1, 08                ; 306  8 bits
i2c_read_byte_L01:
            CALL     i2c_read_bit          ; 307
            SUB      s1, 01                ; 308
            JUMP     NZ, i2c_read_byte_L01 ; 309
            RETURN                         ; 30A
i2c_ack:
            CALL     i2c_sda_low           ; 30B  ACK = SDA low
i2c_clock:
            CALL     i2c_delay5            ; 30C
            CALL     i2c_scl_high          ; 30D
            CALL     i2c_delay4            ; 30E
            CALL     i2c_scl_low           ; 30F
            RETURN                         ; 310
i2c_nack:
            CALL     i2c_sda_high          ; 311  NACK = SDA high
            JUMP     i2c_clock             ; 312
i2c_get_ack:
            CALL     i2c_read_bit          ; 313
            TEST     s5, 01                ; 314  carry = ACK bit (1 = NACK)
            RETURN                         ; 315
i2c_scl_low:
            AND      sF, 02                ; 316  SCL low
            OUTPUT   sF, EC                ; 317
            CALL     i2c_delay5            ; 318
            RETURN                         ; 319
i2c_scl_high:
            OR       sF, 01                ; 31A  release SCL
            OUTPUT   sF, EC                ; 31B
i2c_scl_high_L02:
            INPUT    s0, EB                ; 31C  wait until SCL is high (stretching)
            TEST     s0, 01                ; 31D
            JUMP     Z, i2c_scl_high_L02   ; 31E
            RETURN                         ; 31F
i2c_sda_low:
            AND      sF, 01                ; 320  SDA low
            OUTPUT   sF, EC                ; 321
            RETURN                         ; 322
i2c_sda_high:
            OR       sF, 02                ; 323  release SDA
            OUTPUT   sF, EC                ; 324
            RETURN                         ; 325
i2c_read_bit:
            CALL     i2c_sda_high          ; 326
            CALL     i2c_delay5            ; 327
            CALL     i2c_scl_high          ; 328
            CALL     i2c_delay2            ; 329
            INPUT    s0, EB                ; 32A  sample SDA
            TEST     s0, 02                ; 32B
            SLA      s5                    ; 32C  shift into s5
            CALL     i2c_delay2            ; 32D
            CALL     i2c_scl_low           ; 32E
            RETURN                         ; 32F
i2c_delay5:
            CALL     i2c_delay1            ; 330
i2c_delay4:
            CALL     i2c_delay1            ; 331
            CALL     i2c_delay1            ; 332
i2c_delay2:
            CALL     i2c_delay1            ; 333
            CALL     i2c_delay1            ; 334
            RETURN                         ; 335
i2c_delay1:
            LOAD     s0, 01                ; 336
i2c_delay1_L01:
            SUB      s0, 01                ; 337
            JUMP     NZ, i2c_delay1_L01    ; 338
            RETURN                         ; 339

; ------------------------------------------------------------------------------
; PCF8563 RTC ACCESS (I2C address 51: A2 write, A3 read)
; rtc_write0: register sB = 00.  rtc_write: register sB = sD.
; rtc_select_read: START, A2, register sB, repeated START, A3.
; rtc_read: sD = register sB.
; ------------------------------------------------------------------------------
rtc_write0:
            LOAD     sD, 00                ; 33A  value 00
rtc_write:
            CALL     i2c_idle              ; 33B
            CALL     i2c_start             ; 33C
            LOAD     s5, 51                ; 33D  device address 51 << 1 = A2 (write)
            SL0      s5                    ; 33E
            CALL     i2c_write_byte        ; 33F
            CALL     i2c_get_ack           ; 340
            RETURN C                       ; 341  abort on NACK
            LOAD     s5, sB                ; 342  register number
            CALL     i2c_write_byte        ; 343
            CALL     i2c_get_ack           ; 344
            RETURN C                       ; 345
            LOAD     s5, sD                ; 346  value
            CALL     i2c_write_byte        ; 347
            CALL     i2c_get_ack           ; 348
            RETURN C                       ; 349
            CALL     i2c_stop              ; 34A  STOP
            RETURN                         ; 34B
rtc_select_read:
            CALL     i2c_idle              ; 34C
            CALL     i2c_start             ; 34D
            LOAD     s5, 51                ; 34E
            SL0      s5                    ; 34F
            CALL     i2c_write_byte        ; 350
            CALL     i2c_get_ack           ; 351
            RETURN C                       ; 352
            LOAD     s5, sB                ; 353
            CALL     i2c_write_byte        ; 354
            CALL     i2c_get_ack           ; 355
            RETURN C                       ; 356
            CALL     i2c_start             ; 357
            LOAD     s5, 51                ; 358
            SL1      s5                    ; 359  A3 (read)
            CALL     i2c_write_byte        ; 35A
            CALL     i2c_get_ack           ; 35B
            RETURN C                       ; 35C
            RETURN                         ; 35D
rtc_read:
            CALL     rtc_select_read       ; 35E
            CALL     i2c_read_byte         ; 35F
            LOAD     sD, s5                ; 360
rtc_read_L03:
            CALL     i2c_nack              ; 361
            CALL     i2c_stop              ; 362
            RETURN                         ; 363

; rtc_publish: burst-read PCF8563 registers 2-8 (seconds .. years) and write
; each into the Game Boy RTC window: ED = register number, EE = value
; (the window shows them at $Ax08-$Ax0E).
rtc_publish:
            CALL     rtc_select_read       ; 364
rtc_publish_L01:
            CALL     i2c_read_byte         ; 365
            OUTPUT   sB, ED                ; 366  window index
            OUTPUT   s5, EE                ; 367  window data
            COMPARE  sB, 08                ; 368  last register (years)?
            JUMP     Z, rtc_read_L03       ; 369
            ADD      sB, 01                ; 36A
            CALL     i2c_ack               ; 36B  ACK, read next
            JUMP     rtc_publish_L01       ; 36C

; rtc_set_from_gb (event 10, $7FD0 = 01): for registers 2-8, select the byte
; via F0, read what the Game Boy wrote (B6) and store it in the PCF8563.
rtc_set_from_gb:
            LOAD     sB, 02                ; 36D  first register: seconds
rtc_set_from_gb_L01:
            OUTPUT   sB, F0                ; 36E  select byte sB of the GB data
            LOAD     s0, s0                ; 36F
            INPUT    sD, B6                ; 370  byte the GB wrote
            CALL     rtc_write             ; 371  store in RTC
            COMPARE  sB, 08                ; 372
            RETURN Z                       ; 373
            ADD      sB, 01                ; 374
            JUMP     rtc_set_from_gb_L01   ; 375

; rtc_init: control 1 = 20 (stop), CLKOUT = 80 (enabled), control 1 = 00. If the
; VL (clock integrity) flag in the seconds register is set, reset the clock to
; year 00, month 01, weekday 03, day 01, 00:00:00 and restart it.
rtc_init:
            LOAD     sB, 00                ; 376  control 1 = 20: STOP
            LOAD     sD, 20                ; 377
            CALL     rtc_write             ; 378
            LOAD     sB, 0D                ; 379  CLKOUT control = 80: enabled
            LOAD     sD, 80                ; 37A
            CALL     rtc_write             ; 37B
            LOAD     sB, 00                ; 37C  control 1 = 00: run
            CALL     rtc_write0            ; 37D
            LOAD     sB, 02                ; 37E  seconds register
            CALL     rtc_read              ; 37F
            AND      sD, 80                ; 380  VL flag: clock integrity lost?
            COMPARE  sD, 80                ; 381
            RETURN NZ                      ; 382
            LOAD     sB, 00                ; 383  stop clock
            LOAD     sD, 20                ; 384
            CALL     rtc_write             ; 385
            LOAD     sB, 08                ; 386  years = 00
            CALL     rtc_write0            ; 387
            LOAD     sB, 07                ; 388  months = 01
            LOAD     sD, 01                ; 389
            CALL     rtc_write             ; 38A
            LOAD     sB, 06                ; 38B  weekdays = 03
            LOAD     sD, 03                ; 38C
            CALL     rtc_write             ; 38D
            LOAD     sB, 05                ; 38E  days = 01
            LOAD     sD, 01                ; 38F
            CALL     rtc_write             ; 390
            LOAD     sB, 04                ; 391  hours = 00
            CALL     rtc_write0            ; 392
            LOAD     sB, 03                ; 393  minutes = 00
            CALL     rtc_write0            ; 394
            LOAD     sB, 02                ; 395  seconds = 00 (clears VL)
            CALL     rtc_write0            ; 396
            LOAD     sB, 01                ; 397  control 2 = 00
            CALL     rtc_write0            ; 398
            LOAD     sB, 00                ; 399  control 1 = 00: run
            CALL     rtc_write0            ; 39A
            RETURN                         ; 39B

; ------------------------------------------------------------------------------
; sd_wait_tran: CMD13 until the card status (bits 15:8) is 09 = state "tran"
; and ready-for-data; otherwise send CMD12 and retry.
; ------------------------------------------------------------------------------
sd_wait_tran:
            CALL     sd_cmd13              ; 39C  CMD13 SEND_STATUS
            CALL     sd_get_resp           ; 39D
            FETCH    s0, 04                ; 39E  status bits 15:8
            COMPARE  s0, 09                ; 39F  09 = tran, ready for data
            JUMP     NZ, sd_wait_tran_L06  ; 3A0
            RETURN                         ; 3A1
sd_wait_tran_L06:
            CALL     sd_cmd12              ; 3A2  not ready: CMD12 and retry
            JUMP     sd_wait_tran          ; 3A3

; ------------------------------------------------------------------------------
; ISR: one event per interrupt, read from port B5
;   80  read sectors   ($7FB4 = n)        -> CMD18 + CMD12
;   40  write sectors  ($7FB4 = n | $80)  -> CMD25 + CMD12
;   20  ROM load       ($7F36 = 03)       -> rom_load
;   10  set RTC        ($7FD0 = 01)       -> rtc_set_from_gb
;   08  flash page write (firmware update) -> bank 1 with scratch 3F = 01
; ------------------------------------------------------------------------------
isr:
            INPUT    s3, B5                ; 3A4  event flags
            COMPARE  s3, 80                ; 3A5  read sectors
            JUMP     NZ, isr_L08           ; 3A6
            CALL     sd_wait_tran          ; 3A7  card ready
            CALL     get_gb_sector         ; 3A8  LBA and count from $7FB0-$7FB4
            CALL     sd_read_multi         ; 3A9  CMD18 into the sector buffer
            CALL     sd_cmd12              ; 3AA  CMD12
            JUMP     isr_exit              ; 3AB
isr_L08:
            COMPARE  s3, 40                ; 3AC  write sectors
            JUMP     NZ, isr_L0F           ; 3AD
            CALL     sd_wait_tran          ; 3AE
            CALL     get_gb_sector         ; 3AF
            CALL     sd_write_multi        ; 3B0  CMD25 from the sector buffer
            CALL     sd_cmd12              ; 3B1
            JUMP     isr_exit              ; 3B2
isr_L0F:
            COMPARE  s3, 20                ; 3B3  ROM load
            JUMP     NZ, isr_L13           ; 3B4
            CALL     rom_load              ; 3B5
            JUMP     isr_exit              ; 3B6
isr_L13:
            COMPARE  s3, 10                ; 3B7  set RTC
            JUMP     NZ, isr_L17           ; 3B8
            CALL     rtc_set_from_gb       ; 3B9
            JUMP     isr_exit              ; 3BA
isr_L17:
            COMPARE  s3, 08                ; 3BB  flash page write
            JUMP     NZ, isr_exit          ; 3BC
            LOAD     s2, 01                ; 3BD  scratch 3F = 1: bank 1 takes the update path
            STORE    s2, 3F                ; 3BE
            CALL     bank_call             ; 3BF  -> bank 1
            JUMP     isr_exit              ; 3C0
isr_exit:
            RETURNI  ENABLE                ; 3C1

            ADDRESS 3F0

; ------------------------------------------------------------------------------
; bank_call: switch to program bank 1 and back. Bank 1 has the same eight
; instructions here, except that its 3F3 is "CALL 1B5" (bank-1 dispatcher).
; Writing 1 to C8 switches banks; the NOPs (LOAD s0, s0) cover the fetch
; pipeline, so execution continues at 3F3 in bank 1, calls the bank-1 code, and
; returns to 3F4, where C8 = 0 switches back. In this bank 3F3 is only a NOP.
; ------------------------------------------------------------------------------
bank_call:
            LOAD     s0, 01                ; 3F0
            OUTPUT   s0, C8                ; 3F1  select bank 1
            LOAD     s0, s0                ; 3F2  NOP (pipeline)
            LOAD     s0, s0                ; 3F3  NOP here; CALL 1B5 in bank 1
            LOAD     s0, 00                ; 3F4
            OUTPUT   s0, C8                ; 3F5  select bank 0
            LOAD     s0, s0                ; 3F6  NOP (pipeline)
            RETURN                         ; 3F7
            LOAD     s0, 00                ; 3F8  [unreachable]
            LOAD     s0, 00                ; 3F9  [unreachable]
            LOAD     s0, 00                ; 3FA  [unreachable]
            LOAD     s0, 00                ; 3FB  [unreachable]
            LOAD     s0, 00                ; 3FC  [unreachable]
            LOAD     s0, 00                ; 3FD  [unreachable]
            LOAD     s0, 00                ; 3FE  [unreachable]

; Interrupt vector.
            JUMP     isr                   ; 3FF
